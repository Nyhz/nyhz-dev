---
import '@fontsource-variable/geist-mono';
import geistMono from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
// the name's face: a dot-matrix with weight (dot size) and ROND (square → round) axes
import '@fontsource-variable/doto/full.css';
import doto from '@fontsource-variable/doto/files/doto-latin-full-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Cursor from '../components/Cursor.astro';

const SITE = 'nyhz';
const DEFAULT_TITLE = 'nyhz — creative developer';
const DEFAULT_DESC =
  'Portfolio of nyhz, a creative developer: interactive frontends, WebGL and creative tooling, shown as channels on a TV you can surf.';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESC,
  image = '/og.png',
  robots = 'index, follow',
  // a page to read (the lab's): it scrolls, and there's no loader to wait for
  doc = false,
  // the page's own structured data (a lab entry is a TechArticle), next to the Person
  schema,
} = Astro.props;

// `site` is set in astro.config → these resolve to absolute https URLs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

// for whoever views the source. Injected raw (set:html) so the art keeps its
// spacing — compressHTML would otherwise collapse it.
const SOURCE_NOTE = `<!--

   ███╗   ██╗██╗   ██╗██╗  ██╗███████╗
   ████╗  ██║╚██╗ ██╔╝██║  ██║╚══███╔╝
   ██╔██╗ ██║ ╚████╔╝ ███████║  ███╔╝
   ██║╚██╗██║  ╚██╔╝  ██╔══██║ ███╔╝
   ██║ ╚████║   ██║   ██║  ██║███████╗
   ╚═╝  ╚═══╝   ╚═╝   ╚═╝  ╚═╝╚══════╝

   hi, view-source person. you're my kind of people.

   there's a terminal on the page: the key under esc (or /)
   and a console that talks back: nyhz.help()

   built with astro, raw webgl, gsap and too much coffee.

-->`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'nyhz',
  url: Astro.site?.href,
  jobTitle: 'Creative Developer',
  sameAs: ['https://github.com/nyhz'],
};
---
<!doctype html>
<html lang="en" class:list={{ "is-doc": doc }} data-loaded={doc ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fragment set:html={SOURCE_NOTE} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="nyhz" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={doto} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content={schema ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="nyhz — creative developer" />
    <meta property="og:locale" content="en" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="nyhz — creative developer" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
    <!-- moving around the site swaps the page inside a view transition, no reload (scripts/page.ts) -->
    <ClientRouter />
  </head>
  <body>
    <slot name="bg" />
    <slot name="frame" />
    <main class="page"><slot /></main>
    <slot name="overlay" />
    <Cursor />
    <script>import '../scripts/page';</script>
  </body>
</html>
