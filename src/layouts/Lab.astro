---
// The lab's pages: the site's frame and grain, a reading column, no loader
// and no tv — they load at once and scroll.
import Base from './Base.astro';
import Field from '../components/Field.astro';
import Frame from '../components/Frame.astro';

const { title, description, schema, crumb, image } = Astro.props as {
  title: string; description: string; schema?: object; crumb?: { href: string; label: string }; image?: string;
};
---
<Base title={title} description={description} schema={schema} image={image} doc>
  <Field slot="bg" />
  <Frame slot="frame" />
  <div class="lab">
    <nav class="lab__crumbs" aria-label="breadcrumb">
      <a href="/">nyhz</a><span aria-hidden="true">/</span><a href="/lab/">lab</a>
      {crumb && <><span aria-hidden="true">/</span><span aria-current="page">{crumb.label}</span></>}
    </nav>
    <slot />
  </div>
  <!-- the frame's top and bottom edges: nothing shows past the frame's line,
       and what scrolls up to it blurs and fades on the way in and out -->
  <div class="lab__edge is-top" aria-hidden="true"></div>
  <div class="lab__edge is-bottom" aria-hidden="true"></div>
</Base>

<style>
  .lab { width: min(46rem, 100%); margin: 0 auto; padding-bottom: 4rem; font: 0.92rem/1.75 var(--mono); color: var(--dim); }
  /* one line, always: a long post title is cut short (it's the heading
     right below anyway) */
  .lab__crumbs { display: flex; gap: 0.6rem; margin-bottom: clamp(2.5rem, 7vh, 4rem); white-space: nowrap;
    font: 500 0.66rem var(--mono); letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .lab__crumbs > * { flex: none; }
  .lab__crumbs [aria-current] { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .lab__crumbs a { color: var(--fg); transition: color var(--t-hover) ease; }
  .lab__crumbs a:hover, .lab__crumbs a:focus-visible { color: var(--accent); outline: none; }
  .lab__crumbs [aria-current] { color: var(--muted); }

  /* solid bg out to the frame's line (Frame.astro, same inset; there's no
     grain out there, so it doesn't show), then a fade 3rem in: a background
     that thins out and a blur, both masked away towards the middle. Above the
     text, under the frame, the reading line and the contents */
  .lab__edge { --inset: clamp(14px, 1.6vw, 26px); position: fixed; z-index: 1; left: 0; right: 0;
    height: calc(var(--inset) + 3rem); pointer-events: none;
    -webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px); }
  .lab__edge.is-top { top: 0;
    background: linear-gradient(180deg, var(--bg) var(--inset), color-mix(in srgb, var(--bg) 80%, transparent) var(--inset), transparent);
    -webkit-mask-image: linear-gradient(180deg, #000 var(--inset), transparent); mask-image: linear-gradient(180deg, #000 var(--inset), transparent); }
  .lab__edge.is-bottom { bottom: 0;
    background: linear-gradient(0deg, var(--bg) var(--inset), color-mix(in srgb, var(--bg) 80%, transparent) var(--inset), transparent);
    -webkit-mask-image: linear-gradient(0deg, #000 var(--inset), transparent); mask-image: linear-gradient(0deg, #000 var(--inset), transparent); }
</style>
