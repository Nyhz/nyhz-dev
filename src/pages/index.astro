---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import Frame from '../components/Frame.astro';
import Hero from '../components/Hero.astro';
import Loader from '../components/Loader.astro';
import Terminal from '../components/Terminal.astro';
import Tv from '../components/Tv.astro';
import Eggs from '../components/Eggs.astro';
import Snake from '../components/Snake.astro';
import Cert from '../components/Cert.astro';
import Season from '../components/Season.astro';
import Overclock from '../components/Overclock.astro';
import Cable from '../components/Cable.astro';
import { getContent } from '../scripts/content';
const { profile, projects, skills } = await getContent();
---
<Base title={`${profile.name} — ${profile.role}`}>
  <Field slot="bg" />
  <Frame slot="frame" />
  <Terminal profile={profile} projects={projects} slot="overlay" />
  <Eggs slot="overlay" />
  <Snake slot="overlay" />
  <Cert slot="overlay" />
  <Season slot="overlay" />
  <Overclock slot="overlay" />
  <Cable slot="overlay" />
  <Loader name={profile.name} tagline={profile.role} slot="overlay" />

  <div class="spacer" data-spacer-top></div>
  <section class="hero">
    <Hero
      name={profile.name}
      role={profile.role}
      tagline={profile.tagline}
      location={profile.location}
      socials={profile.socials}
    />
  </section>
  <div class="spacer" data-spacer-mid></div>
  <section class="lower">
    <Tv projects={projects} profile={profile} skills={skills} />
  </section>
</Base>
