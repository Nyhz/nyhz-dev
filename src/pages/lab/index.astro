---
// /lab: the posts — how the things I build actually work, newest first.
// A plain listing, like the tv's channel list: one row a post, no covers
// (those are inside the posts).
import Lab from '../../layouts/Lab.astro';
import { getContent } from '../../scripts/content';
import { getPosts } from '../../scripts/posts';
const { profile } = await getContent();
const posts = getPosts();
const pad = (n: number) => String(n).padStart(2, '0');
---
<Lab title={`lab — ${profile.name}`} description={`Under the hood: how the things ${profile.name} builds actually work, step by step, with the code and the mistakes.`}>
  <header class="lx__head">
    <p class="eyebrow">lab <span class="lx__count">[{pad(posts.length)}]</span> · <a class="lx__rss" href="/lab/rss.xml">rss</a></p>
    <h1 class="lx__h">Under the hood.</h1>
    <p class="lx__lead">How the things I build actually work, step by step, with the code and the mistakes.</p>
  </header>

  <p class="lx__cmd" aria-hidden="true"><span class="lx__prompt">nyhz@lab:~$</span> ls -t<span class="lx__caret"></span></p>
  <ol class="lx__list">
    {posts.map((p, i) => (
      <li>
        <a class="lx__item" href={`/lab/${p.slug}/`}>
          <span class="lx__n">{pad(posts.length - i)}</span>
          <span class="lx__body">
            <span class="lx__t" style={`view-transition-name: title-${p.slug}`}>{p.meta.title}</span>
            <span class="lx__s">{p.meta.summary}</span>
            <span class="lx__meta">{p.minutes} min read{p.meta.tags?.length ? ` · ${p.meta.tags.join(' · ')}` : ''}</span>
          </span>
          <time class="lx__d" datetime={p.meta.date}>{p.meta.date}</time>
        </a>
      </li>
    ))}
  </ol>
</Lab>

<style>
  .lx__head { margin-bottom: clamp(2rem, 5vh, 3rem); }
  .lx__head .eyebrow { margin-bottom: 1rem; }
  .lx__count { color: var(--fg); }
  .lx__rss { color: var(--muted); text-decoration: underline; text-underline-offset: 0.3em; text-decoration-color: var(--line);
    transition: color var(--t-hover) ease; }
  .lx__rss:hover, .lx__rss:focus-visible { color: var(--accent); outline: none; }
  .lx__h { font: 700 clamp(1.5rem, 3.4vw, 2.2rem)/1.2 var(--mono); color: var(--fg); letter-spacing: -0.015em; margin-bottom: 0.9rem; }
  .lx__lead { max-width: 52ch; }

  /* the command that "printed" the list */
  .lx__cmd { margin-bottom: 0.7rem; font: 500 0.7rem var(--mono); letter-spacing: 0.04em; color: var(--dim); }
  .lx__prompt { color: var(--accent); }
  .lx__caret { display: inline-block; width: 0.55em; height: 1.05em; margin-left: 0.35em; vertical-align: -0.2em;
    background: var(--fg); animation: lxBlink 1.1s steps(1) infinite; }
  @keyframes lxBlink { 50% { opacity: 0; } }

  /* one row a post, ruled like the tv's channel list: number, the post, its
     date. Hover never changes a box's size (colours, a transform and a text
     shadow only), so no line ever re-wraps */
  .lx__list { list-style: none; border-bottom: 1px solid var(--line); }
  .lx__item { position: relative; display: grid; grid-template-columns: 2.6ch minmax(0, 1fr) auto; gap: 0 1rem;
    padding: 1.05rem 0.2rem 1.15rem; border-top: 1px solid var(--line); }
  .lx__item::before { content: ''; position: absolute; left: -0.9rem; top: 1.2rem; width: 2px; height: 1.1rem;
    background: var(--accent); box-shadow: 0 0 8px var(--accent); transform: scaleY(0); transition: transform 0.25s var(--ease-out); }
  .lx__n { padding-top: 0.32rem; font: 500 0.66rem var(--mono); color: var(--muted); transition: color var(--t-hover) ease; }
  .lx__body { display: grid; gap: 0.4rem; min-width: 0; transition: transform 0.3s var(--ease-out); }
  .lx__t { font: 700 1rem/1.4 var(--mono); color: var(--fg); letter-spacing: -0.005em; transition: color var(--t-hover) ease; }
  .lx__s { font-size: 0.8rem; line-height: 1.6; color: var(--dim); max-width: 62ch; }
  .lx__meta, .lx__d { font: 500 0.6rem var(--mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .lx__d { padding-top: 0.3rem; white-space: nowrap; font-variant-numeric: tabular-nums; }

  .lx__item:hover .lx__n, .lx__item:focus-visible .lx__n,
  .lx__item:hover .lx__t, .lx__item:focus-visible .lx__t { color: var(--accent); }
  .lx__item:hover .lx__body, .lx__item:focus-visible .lx__body { transform: translateX(0.35rem); }
  .lx__item:hover::before, .lx__item:focus-visible::before { transform: scaleY(1); }
  .lx__item:hover .lx__t, .lx__item:focus-visible .lx__t { animation: lxGlitch 0.36s steps(2) 1; }
  .lx__item:focus-visible { outline: none; }
  /* the hero's glitch, once, as the row lights up */
  @keyframes lxGlitch {
    0% { text-shadow: -2px 0 #ff2e63, 2px 0 #2ee6ff; }
    50% { text-shadow: 2px 0 #ff2e63, -2px 0 #2ee6ff; }
    100% { text-shadow: none; }
  }

  /* narrow: the date joins the meta line's row, under the number */
  @media (max-width: 560px) {
    .lx__item { grid-template-columns: 2.6ch minmax(0, 1fr); }
    .lx__d { grid-column: 2; padding-top: 0.15rem; }
    .lx__item::before { left: -0.6rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lx__caret { animation: none; }
    .lx__item:hover .lx__t, .lx__item:focus-visible .lx__t { animation: none; }
    .lx__item::before, .lx__body { transition: none; }
  }
</style>
