---
// /lab/<slug>: one post, from its markdown (src/content/lab/<slug>.md).
import Lab from '../../layouts/Lab.astro';
import { getContent } from '../../scripts/content';
import { getPosts, type Post } from '../../scripts/posts';

export async function getStaticPaths() {
  return getPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const { meta, Content } = post;
const { profile } = await getContent();
const schema = {
  '@context': 'https://schema.org', '@type': 'TechArticle',
  headline: meta.title, description: meta.summary, datePublished: meta.date,
  url: new URL(`/lab/${post.slug}/`, Astro.site).href,
  author: { '@type': 'Person', name: profile.name, url: Astro.site?.href },
  keywords: (meta.tags ?? []).join(', '),
  ...(meta.image ? { image: new URL(meta.image, Astro.site).href } : {}),
};
---
<Lab title={`${meta.title} — ${profile.name}`} description={meta.summary} schema={schema} image={meta.image} crumb={{ href: `/lab/${post.slug}/`, label: meta.title }}>
  <article class="post">
    <header class="post__head">
      <p class="eyebrow"><time datetime={meta.date}>{meta.date}</time> · {post.minutes} min read{meta.tags?.length ? ` · ${meta.tags.join(' · ')}` : ''}</p>
      <h1 class="post__h" style={`view-transition-name: title-${post.slug}`}>{meta.title}</h1>
      <p class="post__sum">{meta.summary}</p>
    </header>
    {meta.cover && <figure class="post__cover" style={`view-transition-name: cover-${post.slug}`}><img src={meta.cover} alt={`${meta.title}: the finished thing`} width="1600" height="840" decoding="async" fetchpriority="high" /></figure>}
    <div class="post__body"><Content /></div>
    <footer class="post__foot">
      <a href="/lab/">← back to the lab</a>
    </footer>
  </article>
</Lab>

<style>
  .post__head { margin-bottom: 2rem; }
  .post__cover { margin: 0 0 2.6rem; border: 1px solid var(--line); background: #0c0c0b; }
  .post__cover img { display: block; width: 100%; height: auto; }
  .post__head .eyebrow { margin-bottom: 1rem; }
  .post__h { font: 700 clamp(1.8rem, 4.4vw, 2.8rem)/1.1 var(--mono); color: var(--fg); letter-spacing: -0.02em; margin-bottom: 0.9rem; }
  .post__sum { font-size: 1rem; line-height: 1.7; }

  /* the markdown */
  .post__body :global(p) { margin-bottom: 1.15rem; }
  .post__body :global(h2) { font: 700 1.15rem/1.35 var(--mono); color: var(--fg); margin: 3rem 0 1rem; letter-spacing: -0.01em; }
  .post__body :global(strong) { color: var(--fg); font-weight: 700; }
  .post__body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 0.25em; }
  .post__body :global(ul) { margin: 0 0 1.2rem 1.2rem; }
  .post__body :global(li) { margin-bottom: 0.55rem; padding-left: 0.3rem; }
  .post__body :global(li::marker) { color: var(--accent); }
  .post__body :global(:not(pre) > code) { font: 0.85em var(--mono); color: var(--fg); background: #161614; border: 1px solid var(--line);
    padding: 0.08em 0.35em; overflow-wrap: anywhere; }
  .post__body :global(pre) { margin: 0.4rem 0 1.6rem; padding: 1.05rem 1.2rem; border: 1px solid var(--line);
    background: #080808 !important; font: 0.8rem/1.7 var(--mono); }
  /* no sideways scroll: a long line wraps, and what wraps hangs four columns
     past the line's own indent (--lead, set per line in astro.config), so it
     still reads as the same line */
  .post__body :global(pre .line) { --hang: calc((var(--lead, 0) + 4) * 1ch);
    display: inline-block; width: 100%; padding-left: var(--hang); text-indent: calc(-1 * var(--hang)); }
  @media (max-width: 520px) { .post__body :global(pre) { font-size: 0.74rem; padding: 0.9rem 0.85rem; } }
  .post__foot { margin-top: 3.4rem; padding-top: 1.3rem;
    border-top: 1px solid var(--line); font: 500 0.7rem var(--mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .post__foot a { color: var(--fg); transition: color var(--t-hover) ease; }
  .post__foot a:hover, .post__foot a:focus-visible { color: var(--accent); outline: none; }
</style>
