---
// /lab/<slug>: one post, from its markdown (src/content/lab/<slug>.md).
import Lab from '../../layouts/Lab.astro';
import { getContent } from '../../scripts/content';
import { getPosts, type Post } from '../../scripts/posts';

export async function getStaticPaths() {
  return getPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const { meta, Content } = post;
const { profile } = await getContent();
const schema = {
  '@context': 'https://schema.org', '@type': 'TechArticle',
  headline: meta.title, description: meta.summary, datePublished: meta.date,
  url: new URL(`/lab/${post.slug}/`, Astro.site).href,
  author: { '@type': 'Person', name: profile.name, url: Astro.site?.href },
  keywords: (meta.tags ?? []).join(', '),
  ...(meta.image ? { image: new URL(meta.image, Astro.site).href } : {}),
};
---
<Lab title={`${meta.title} — ${profile.name}`} description={meta.summary} schema={schema} image={meta.image} crumb={{ href: `/lab/${post.slug}/`, label: meta.title }}>
  <!-- reading progress: the frame's top line fills as you read -->
  <div class="post__progress" aria-hidden="true"><i data-read><b></b></i></div>
  <!-- the sections, in the margin on wide screens; the one you're in lights up -->
  {post.sections.length > 2 && (
    <nav class="toc" aria-label="contents">
      <p class="toc__h">— contents</p>
      <ol>
        {post.sections.map((s) => (
          <li><a href={`#${s.id}`} data-toc={s.id}><span class="toc__n">{s.n || '··'}</span><span class="toc__t">{s.text}</span></a></li>
        ))}
      </ol>
    </nav>
  )}
  <article class="post">
    <header class="post__head">
      <p class="eyebrow"><time datetime={meta.date}>{meta.date}</time> · {post.minutes} min read</p>
      <h1 class="post__h" style={`view-transition-name: title-${post.slug}`}>{meta.title}</h1>
      <p class="post__sum">{meta.summary}</p>
      {meta.tags?.length && <p class="post__tags">{meta.tags.join(' · ')}</p>}
    </header>
    {meta.cover && <figure class="post__cover" style={`view-transition-name: cover-${post.slug}`}><img src={meta.cover} alt={`${meta.title}: the finished thing`} width="1600" height="840" decoding="async" fetchpriority="high" /></figure>}
    <div class="post__body"><Content /></div>
    <footer class="post__foot">
      <a href="/lab/">← back to the lab</a>
    </footer>
  </article>
</Lab>

<style>
  /* laid over the frame's top line (Frame.astro: same inset). The fill slides
     in from the left (a transform per frame, never a layout), clipped at the
     frame's sides but free to glow above and below the line */
  .post__progress { --inset: clamp(14px, 1.6vw, 26px); position: fixed; z-index: 3; top: calc(var(--inset) - 0.5px);
    left: var(--inset); right: var(--inset); height: 2px; pointer-events: none; clip-path: inset(-6px 0); }
  /* the fill: a trail, faint where you started, full at where you are */
  .post__progress i { position: absolute; inset: 0;
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 12%, transparent), var(--accent));
    transform: translateX(-100%); }
  /* the head: a playhead tick on the line */
  .post__progress b { position: absolute; right: -1px; top: -3px; width: 2px; height: 8px; background: #eafff6;
    box-shadow: 0 0 6px 1px var(--accent), 0 0 16px var(--accent); }
  /* while you scroll the head splits, red and cyan */
  .post__progress.is-moving b { box-shadow: -2px 0 #ff2e63, 2px 0 #2ee6ff, 0 0 12px var(--accent); }
  @media (prefers-reduced-motion: reduce) {
    .post__progress.is-moving b { box-shadow: 0 0 6px 1px var(--accent), 0 0 16px var(--accent); }
  }
  /* the contents: fixed in the left margin, clear of the column (46rem wide,
     centred) — only where the margin has room for it, and the screen the
     height for a dozen sections */
  .toc { display: none; }
  @media (min-width: 1300px) and (min-height: 640px) {
    .toc { display: block; position: fixed; z-index: 2; top: clamp(7rem, 22vh, 11rem); width: 12rem;
      left: calc(50% - 23rem - 2.5rem - 12rem); }
  }
  .toc__h { margin-bottom: 0.9rem; font: 500 0.6rem var(--mono); letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); }
  .toc ol { list-style: none; display: grid; gap: 0.15rem; }
  .toc a { position: relative; display: grid; grid-template-columns: 2.4ch minmax(0, 1fr); gap: 0 0.7rem; padding: 0.22rem 0;
    font: 500 0.68rem/1.45 var(--mono); color: var(--muted); transition: color var(--t-hover) ease; }
  .toc a::before { content: ''; position: absolute; left: -0.8rem; top: 0.38rem; width: 2px; height: 0.8rem;
    background: var(--accent); box-shadow: 0 0 8px var(--accent); transform: scaleY(0); transition: transform 0.25s var(--ease-out); }
  .toc__n { font-size: 0.6rem; padding-top: 0.08rem; font-variant-numeric: tabular-nums; }
  .toc__t { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .toc a:hover, .toc a:focus-visible { color: var(--fg); outline: none; }
  .toc a.is-here { color: var(--fg); }
  .toc a.is-here .toc__n { color: var(--accent); }
  .toc a.is-here::before { transform: scaleY(1); }
  .toc a.is-here .toc__t { animation: tocGlitch 0.36s steps(2) 1; }
  @keyframes tocGlitch {
    0% { text-shadow: -2px 0 #ff2e63, 2px 0 #2ee6ff; }
    50% { text-shadow: 2px 0 #ff2e63, -2px 0 #2ee6ff; }
    100% { text-shadow: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .toc a::before { transition: none; }
    .toc a.is-here .toc__t { animation: none; }
  }

  .post__head { margin-bottom: 2rem; }
  .post__cover { margin: 0 0 2.6rem; border: 1px solid var(--line); background: #0c0c0b; }
  .post__cover img { display: block; width: 100%; height: auto; }
  .post__head .eyebrow { margin-bottom: 1rem; }
  .post__h { font: 700 clamp(1.8rem, 4.4vw, 2.8rem)/1.1 var(--mono); color: var(--fg); letter-spacing: -0.02em; margin-bottom: 0.9rem; }
  .post__sum { font-size: 1rem; line-height: 1.7; }
  .post__tags { margin-top: 1rem; font: 500 0.6rem var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }

  /* the markdown */
  .post__body :global(p) { margin-bottom: 1.15rem; }
  .post__body :global(h2) { font: 700 1.15rem/1.35 var(--mono); color: var(--fg); margin: 3rem 0 1rem; letter-spacing: -0.01em;
    scroll-margin-top: 4.5rem; }
  .post__body :global(strong) { color: var(--fg); font-weight: 700; }
  .post__body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 0.25em; }
  .post__body :global(ul) { margin: 0 0 1.2rem 1.2rem; }
  .post__body :global(li) { margin-bottom: 0.55rem; padding-left: 0.3rem; }
  .post__body :global(li::marker) { color: var(--accent); }
  .post__body :global(:not(pre) > code) { font: 0.85em var(--mono); color: var(--fg); background: #161614; border: 1px solid var(--line);
    padding: 0.08em 0.35em; overflow-wrap: anywhere; }
  .post__body :global(pre) { margin: 0.4rem 0 1.6rem; padding: 1.05rem 1.2rem; border: 1px solid var(--line);
    background: #080808 !important; font: 0.8rem/1.7 var(--mono); }
  /* no sideways scroll: a long line wraps, and what wraps hangs four columns
     past the line's own indent (--lead, set per line in astro.config), so it
     still reads as the same line */
  .post__body :global(pre .line) { --hang: calc((var(--lead, 0) + 4) * 1ch);
    display: inline-block; width: 100%; padding-left: var(--hang); text-indent: calc(-1 * var(--hang)); }
  @media (max-width: 520px) { .post__body :global(pre) { font-size: 0.74rem; padding: 0.9rem 0.85rem; } }
  /* selecting code (Cursor.astro turns into an I-beam over it): teal, not the system's blue */
  .post__body :global(pre ::selection) { background: color-mix(in srgb, var(--accent) 32%, transparent); color: #fff; }
  /* copy: a tab sitting on the block's top border (so it never covers code),
     shown on hover — always, where there's no hover */
  .post__body :global(.code) { position: relative; }
  .post__body :global(.code__copy) { position: absolute; top: 0.4rem; right: 0.9rem; transform: translateY(-50%);
    padding: 0.18rem 0.55rem; background: #080808; border: 1px solid var(--line); cursor: pointer;
    font: 500 0.56rem var(--mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);
    opacity: 0; transition: opacity var(--t-hover) ease, color var(--t-hover) ease, border-color var(--t-hover) ease; }
  .post__body :global(.code:hover .code__copy), .post__body :global(.code__copy:focus-visible) { opacity: 1; }
  .post__body :global(.code__copy:hover), .post__body :global(.code__copy:focus-visible) { color: var(--fg); border-color: var(--muted); outline: none; }
  .post__body :global(.code__copy.is-done) { opacity: 1; color: var(--accent); border-color: var(--accent);
    animation: tocGlitch 0.36s steps(2) 1; }
  @media (hover: none) { .post__body :global(.code__copy) { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .post__body :global(.code__copy.is-done) { animation: none; } }
  .post__foot { margin-top: 3.4rem; padding-top: 1.3rem;
    border-top: 1px solid var(--line); font: 500 0.7rem var(--mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .post__foot a { color: var(--fg); transition: color var(--t-hover) ease; }
  .post__foot a:hover, .post__foot a:focus-visible { color: var(--accent); outline: none; }
</style>

<script>
  import { onPage } from '../../scripts/page';

  // how far through the post you are: 0 at the top, 1 once its end is in view
  onPage((signal) => {
    const line = document.querySelector<HTMLElement>('.post__progress');
    const bar = line?.querySelector<HTMLElement>('[data-read]');
    const post = document.querySelector<HTMLElement>('.post');
    if (!line || !bar || !post) return;
    let raf = 0, still = 0;
    const paint = () => {
      raf = 0;
      const end = post.offsetTop + post.offsetHeight - innerHeight;
      const read = end > 0 ? Math.min(1, Math.max(0, scrollY / end)) : 1;
      bar.style.transform = `translateX(${(read - 1) * 100}%)`;
    };
    const ask = () => { raf ||= requestAnimationFrame(paint); };
    const scrolled = () => {
      line.classList.add('is-moving');
      ask();
      clearTimeout(still);
      still = window.setTimeout(() => line.classList.remove('is-moving'), 180);
    };
    addEventListener('scroll', scrolled, { passive: true, signal });
    addEventListener('resize', ask, { signal });
    signal.addEventListener('abort', () => { cancelAnimationFrame(raf); clearTimeout(still); });
    paint();
  });

  // the contents: the section you're in is the last one whose heading has
  // passed a third of the way down the screen. A click scrolls there
  onPage((signal) => {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
    const heads = links.map((a) => document.getElementById(a.dataset.toc!)).filter((h): h is HTMLElement => !!h);
    if (!links.length || heads.length !== links.length) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let raf = 0, here = -2;
    const paint = () => {
      raf = 0;
      const line = innerHeight / 3;
      let i = -1;
      heads.forEach((h, j) => { if (h.getBoundingClientRect().top <= line) i = j; });
      if (i === here) return;
      here = i;
      links.forEach((a, j) => a.classList.toggle('is-here', j === i));
    };
    const ask = () => { raf ||= requestAnimationFrame(paint); };
    addEventListener('scroll', ask, { passive: true, signal });
    addEventListener('resize', ask, { signal });
    links.forEach((a, j) => a.addEventListener('click', (e) => {
      e.preventDefault();
      heads[j].scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(history.state, '', `#${heads[j].id}`);
    }, { signal }));
    signal.addEventListener('abort', () => cancelAnimationFrame(raf));
    paint();
  });

  // a copy button on every code block
  onPage((signal) => {
    document.querySelectorAll<HTMLPreElement>('.post__body pre').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code')) return;
      const box = document.createElement('div');
      box.className = 'code';
      pre.before(box);
      box.append(pre);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code__copy';
      btn.textContent = 'copy';
      btn.setAttribute('aria-label', 'copy this code');
      box.append(btn);
      let t = 0;
      const say = (text: string) => {
        btn.textContent = text;
        btn.classList.add('is-done');
        clearTimeout(t);
        t = window.setTimeout(() => { btn.textContent = 'copy'; btn.classList.remove('is-done'); }, 1600);
      };
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.textContent ?? '');
          say('copied');
        } catch {
          // no clipboard (an old browser, an insecure page): select it instead
          getSelection()?.selectAllChildren(pre);
          say('selected');
        }
      }, { signal });
      signal.addEventListener('abort', () => clearTimeout(t));
    });
  });
</script>
