<div class="field-clip" aria-hidden="true">
  <canvas class="field-canvas"></canvas>
</div>
<script>
  import { createGrain } from '../scripts/grain';
  const canvas = document.querySelector('canvas.field-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const grain = (() => { try { return createGrain(canvas); } catch { return null; } })();
    if (!grain) { canvas.style.display = 'none'; }
    else {
      grain.start();
      // the terminal's `glitch` command (and the name's own glitch) send a
      // shockwave out from the wordmark
      addEventListener('nyhz:shock', (e) => {
        const { x, y, strength = 1.6 } = (e as CustomEvent).detail ?? {};
        grain.ripple(x ?? innerWidth / 2, y ?? innerHeight / 2, strength);
      });
      // the screensaver's logo carries the lamp around
      addEventListener('nyhz:lamp', (e) => {
        const { x, y } = (e as CustomEvent).detail ?? {};
        if (typeof x === 'number' && typeof y === 'number') grain.lamp(x, y);
      });
    }
  }
</script>
