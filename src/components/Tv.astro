---
// The work, as television: one monitor (16:10, sized to the room it has) and
// the projects as channels. Hovering a channel tunes to it — static, a roll,
// a chromatic split and the channel number flashing — and a click locks it.
// It starts switched off (standby); touching a channel powers it on, CRT
// style, and from then on, left alone, it channel-surfs like a TV in a shop
// window.
// The project's details sit on the screen as an on-screen display. "say hi"
// tunes to CH 00: the contact form, over static.
// Phones: the screen goes full width; swipe it (or ◀ ▶) to change channels,
// and the details sit under it.
import Contact from './Contact.astro';
import { statusOf, type ProjectProps, type ProfileProps, type SkillProps } from '../scripts/content';
import type { TxtContext } from '../scripts/tv';

const { projects, profile, skills = [] } = Astro.props as { projects: ProjectProps[]; profile: ProfileProps; skills?: SkillProps[] };
const shown = projects.slice(0, 10);
const pad = (n: number) => String(n).padStart(2, '0');
// what the teletext pages are made of
const txt: TxtContext = {
  name: profile.name, role: profile.role, location: profile.location, socials: profile.socials,
  projects: shown.map((p) => ({ title: p.title, status: statusOf(p) })),
  skills: skills.map((s) => ({ title: s.title, items: s.items })),
};
---
<div class="tv is-off" data-tv data-anim data-txt={JSON.stringify(txt)}>
  <div class="tv__set">
    <div class="tv__screen" data-tv-screen>
      <i class="tv__tick tl"></i><i class="tv__tick tr"></i><i class="tv__tick bl"></i><i class="tv__tick br"></i>
      <div class="tv__glass" data-tv-glass>
        <!-- the picture: power on/off squeezes this to a line, the glass
             (and its frame) stays put -->
        <div class="tv__pic" data-tv-pic>
          <img class="tv__fill" data-tv-fill alt="" decoding="async" />
          <img class="tv__img" data-tv-img alt="" decoding="async" />
          <img class="tv__img" data-tv-img alt="" decoding="async" />
          <canvas class="tv__static" data-tv-static width="160" height="100"></canvas>
          <a class="tv__hit" data-tv-hit target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"></a>
          <div data-nosnippet class="tv__osd" aria-hidden="true">
            <span class="tv__ch" data-tv-ch>CH 01</span>
            <span class="tv__state" data-tv-state></span>
          </div>
          <p class="tv__big" data-tv-big aria-hidden="true"></p>
          <!-- phones: the whole description, read on the screen itself -->
          <div class="tv__read" data-tv-read hidden><p data-tv-read-t></p><span class="tv__read-x">tap to close</span></div>
          <!-- the channels that aren't in the list: no signal, 42, 13, the ads -->
          <div class="tv__special" data-tv-special hidden></div>
          <!-- teletext -->
          <div class="tv__ttx" data-tv-ttx hidden><div class="tv__ttx-in" data-tv-ttx-in></div></div>
          <p class="tv__vol" data-tv-vol aria-hidden="true"></p>
          <i class="tv__bar" data-tv-bar aria-hidden="true"></i>
          <!-- the news ticker: what's actually going on (the deploys answering,
               the last push, the secrets) — filled in and scrolled by the script -->
          <div data-nosnippet class="tv__news" data-tv-news aria-hidden="true">
            <span class="tv__news-tag">news</span>
            <div class="tv__news-run"><div class="tv__news-track" data-tv-news-track></div></div>
          </div>
        </div>
        <i class="tv__line" data-tv-line aria-hidden="true"></i>
        <i class="tv__ember" data-tv-ember aria-hidden="true"></i>
      </div>

      <!-- phones only: change channels right under the picture -->
      <div data-nosnippet class="tv__nav" aria-label="channels">
        <button type="button" class="tv__navbtn" data-tv-prev aria-label="previous channel">◀</button>
        <span class="tv__navn">CH <b data-tv-n>01</b> / {pad(shown.length)}</span>
        <button type="button" class="tv__navbtn" data-tv-next aria-label="next channel">▶</button>
        <button type="button" class="tv__navbtn tv__navbtn--sm" data-tv-txt aria-pressed="false">txt</button>
        <button type="button" class="tv__navbtn tv__navbtn--sm" data-tv-power aria-label="power">⏻</button>
      </div>

      <!-- the lower third: over the picture on desktop, under it on phones -->
      <div class="tv__l3" data-tv-l3 aria-live="polite">
        <h2 class="tv__title"><span data-tv-title></span><span class="tv__year" data-tv-year></span></h2>
        <div class="tv__descwrap">
          <p class="tv__desc" data-tv-desc></p>
          <button type="button" class="tv__more" data-tv-more hidden>+ more</button>
        </div>
        <div class="tv__meta">
          <span class="tv__stack" data-tv-stack></span>
          <nav class="tv__links" aria-label="project links">
            <a class="tv__btn tv__btn--go" data-tv-live target="_blank" rel="noopener noreferrer" hidden><span aria-hidden="true">↗</span> live</a>
            <a class="tv__btn tv__btn--go" data-tv-download target="_blank" rel="noopener noreferrer" hidden><span aria-hidden="true">↓</span> download</a>
            <a class="tv__btn" data-tv-repo target="_blank" rel="noopener noreferrer" hidden><span aria-hidden="true">↗</span> source</a>
          </nav>
        </div>
      </div>

      <!-- CH 00: "say hi" -->
      <section class="tv__contact" id="contact" data-tv-contact aria-label="contact" hidden>
        <p class="tv__contact-h">write to me <button class="tv__x" type="button" data-tv-close aria-label="close contact">esc ×</button></p>
        <Contact />
      </section>
    </div>

  </div>

  <div class="tv__side">
    <p class="sec-label">— channels <span class="sec-count">[{pad(shown.length)}]</span></p>
    <ul class="tv__list" data-tv-list>
      {shown.map((p, i) => (
        <li>
          <button type="button" class="tv__chbtn" data-ch={i}
            data-slug={p.slug} data-title={p.title} data-desc={p.description} data-tags={p.tags.join(' · ')}
            data-cover={p.coverUrl} data-live={p.deployUrl} data-download={p.downloadUrl} data-repo={p.repoUrl}
            data-year={p.year} data-status={statusOf(p)} aria-label={`Tune to ${p.title}`}>
            <span class="tv__chn">{pad(i + 1)}</span>
            <span class="tv__chname">{p.title}</span>
            <i class="tv__dot" data-s={statusOf(p)} aria-hidden="true"></i>
          </button>
        </li>
      ))}
    </ul>
    <!-- the remote: power, teletext, and what the keyboard does -->
    <div data-nosnippet class="tv__remote">
      <button type="button" class="tv__rbtn" data-tv-power aria-label="power">⏻</button>
      <button type="button" class="tv__rbtn" data-tv-txt aria-pressed="false">txt</button>
      <span class="tv__keys" aria-hidden="true">0–9 · + −</span>
    </div>
  </div>

  <!-- the same projects as plain text: the tv shows them as pictures and data
       attributes, which search engines don't index and screen readers can't
       browse. Visually hidden, links out of the tab order. -->
  <section class="tv__index" aria-labelledby="tv-index-h">
    <h2 id="tv-index-h">projects</h2>
    {shown.map((p) => (
      <article>
        <h3>{p.title}{p.year ? ` (${p.year})` : ''}</h3>
        <p>{p.description}</p>
        {p.tags.length > 0 && <p>built with {p.tags.join(', ')}</p>}
        {p.deployUrl && <a href={p.deployUrl} tabindex="-1">{p.title} — live</a>}
        {p.downloadUrl && <a href={p.downloadUrl} tabindex="-1">{p.title} — download</a>}
        {p.repoUrl && <a href={p.repoUrl} tabindex="-1">{p.title} — source</a>}
      </article>
    ))}
  </section>
</div>

<style>
  .tv__index { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .tv { display: grid; grid-template-columns: auto minmax(11rem, 14rem); justify-content: space-between;
    align-items: center; gap: 0 clamp(1.5rem, 3vw, 2.5rem); height: 100%; }
  .tv__set { min-width: 0; }

  /* ---- the screen ---- */
  .tv__screen { position: relative; width: var(--tv-w, 560px); height: var(--tv-h, 350px); }
  .tv__tick { position: absolute; z-index: 3; width: 11px; height: 11px; border: 1px solid var(--fg); pointer-events: none; }
  .tv__tick.tl { top: -5px; left: -5px; border-right: 0; border-bottom: 0; }
  .tv__tick.tr { top: -5px; right: -5px; border-left: 0; border-bottom: 0; }
  .tv__tick.bl { bottom: -5px; left: -5px; border-right: 0; border-top: 0; }
  .tv__tick.br { bottom: -5px; right: -5px; border-left: 0; border-top: 0; }
  .tv__glass { position: absolute; inset: 0; overflow: hidden; background: #0c0c0b; border: 1px solid var(--line); }
  .tv__pic { position: absolute; inset: 0; }
  /* ambilight (scripts/ambilight.ts): each edge of the picture glows its own
     colour round the set; dark when there's no cover on screen */
  .tv__glass { box-shadow: -24px 0 64px -20px var(--amb-l, transparent), 0 -24px 64px -20px var(--amb-t, transparent),
      24px 0 64px -20px var(--amb-r, transparent), 0 24px 64px -20px var(--amb-b, transparent);
    transition: box-shadow 0.9s ease; }
  .tv.is-off .tv__glass, .tv.is-contact .tv__glass, .tv.is-ttx .tv__glass, .tv.is-special .tv__glass {
    --amb-l: transparent; --amb-t: transparent; --amb-r: transparent; --amb-b: transparent; }
  .tv__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 10%;
    opacity: 0; filter: saturate(0.85) contrast(1.05); }
  .tv__img.is-top { opacity: 1; }
  /* a cover that isn't (nearly) 16:10 is shown whole — never cropped — and
     the rest of the screen is filled with itself, blurred and dimmed */
  .tv__img.is-contain { object-fit: contain; object-position: 50% 32%; }
  .tv__fill { position: absolute; inset: -8%; width: 116%; height: 116%; object-fit: cover; opacity: 0;
    filter: blur(22px) brightness(0.42) saturate(1.2); transition: opacity 0.2s ease; }
  .tv__fill.is-on { opacity: 1; }
  /* glass: scanlines, a vignette and a faint glare */
  .tv__pic::after { content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 1;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px),
      radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.45) 100%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.05), transparent 40%); }
  .tv__static { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; opacity: 0;
    image-rendering: pixelated; pointer-events: none; mix-blend-mode: screen; }
  .tv__hit { position: absolute; inset: 0; z-index: 1; cursor: pointer; }
  /* standby: no picture, a red pilot light */
  .tv.is-off .tv__img, .tv.is-off .tv__fill { opacity: 0 !important; }
  .tv.is-off .tv__hit { cursor: pointer; }
  /* switching off: the dot the line dies into glows on a moment and fades,
     like a tube's phosphor — right where the line ends, the screen's centre */
  .tv__ember { position: absolute; z-index: 5; left: 50%; top: 50%; width: 4px; height: 4px; margin: -2px 0 0 -2px;
    border-radius: 50%; background: #fff; box-shadow: 0 0 14px 4px rgba(242, 241, 234, 0.35); opacity: 0; pointer-events: none; }
  .tv__state[data-s="off"]::before { content: '● '; color: #ff2e63; text-shadow: 0 0 6px #ff2e63; }
  /* powering on: a bright line that the picture opens out of */
  .tv__line { position: absolute; z-index: 5; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; background: #fff;
    box-shadow: 0 0 12px 2px rgba(255, 255, 255, 0.8), 0 0 34px rgba(58, 210, 159, 0.6);
    transform: scaleX(0); opacity: 0; pointer-events: none; }
  .tv__hit:not([href]) { cursor: default; }

  /* on-screen display */
  /* a soft shade under the on-screen display, so it reads over any picture */
  .tv__pic::before { content: ''; position: absolute; z-index: 2; left: 0; right: 0; top: 0; height: 4rem; pointer-events: none;
    background: linear-gradient(rgba(8, 8, 8, 0.7), transparent); }
  .tv__osd { position: absolute; z-index: 3; top: 0.8rem; left: 1rem; right: 1rem; display: flex; justify-content: space-between;
    font: 500 0.66rem var(--mono); letter-spacing: 0.18em; text-transform: uppercase; color: #f2f1ea;
    text-shadow: 0 0 6px rgba(0, 0, 0, 0.9), 0 0 2px rgba(0, 0, 0, 0.9); pointer-events: none; }
  .tv__ch { color: var(--accent); }
  .tv__state[data-s="live"]::before { content: '● '; color: var(--accent); }
  .tv__state[data-s="download"]::before { content: '↓ '; }
  .tv__state[data-s="in progress"]::before { content: '◐ '; color: #f5c542; }
  .tv__big { position: absolute; z-index: 3; top: 50%; left: 50%; translate: -50% -50%; margin: 0; opacity: 0; pointer-events: none;
    font: 700 clamp(2.4rem, 7vw, 4.6rem)/1 var(--mono); letter-spacing: 0.02em; color: #f2f1ea;
    text-shadow: -3px 0 rgba(255, 46, 99, 0.85), 3px 0 rgba(46, 230, 255, 0.85), 0 0 24px rgba(0, 0, 0, 0.8); }
  .tv__bar { position: absolute; z-index: 4; left: 0; bottom: var(--news-h); height: 2px; width: 100%; background: var(--accent);
    transform: scaleX(0); transform-origin: left; opacity: 0.8; pointer-events: none; }
  .tv.is-special .tv__bar { bottom: 0; }

  /* ---- the news ticker, along the bottom of the picture ---- */
  .tv { --news-h: 1.6rem; }
  .tv__news { position: absolute; z-index: 3; left: 0; right: 0; bottom: 0; height: var(--news-h); display: flex;
    background: rgba(6, 6, 6, 0.92); border-top: 1px solid rgba(242, 241, 234, 0.1);
    font: 500 0.6rem/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: #f2f1ea;
    transition: opacity 0.3s ease, visibility 0.3s; }
  /* scanlines, like the rest of the picture */
  .tv__news::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.25) 0 1px, transparent 1px 3px); }
  /* only on a channel: not in standby, the form, teletext or the special channels */
  .tv.is-off .tv__news, .tv.is-contact .tv__news, .tv.is-ttx .tv__news, .tv.is-special .tv__news { opacity: 0; visibility: hidden; }
  .tv__news-tag { flex: none; display: flex; align-items: center; gap: 0.5em; padding: 0 0.75rem;
    background: var(--accent); color: #04140d; font-weight: 700; letter-spacing: 0.2em; }
  .tv__news-tag::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor;
    animation: newsDot 1.2s steps(1) infinite; }
  @keyframes newsDot { 50% { opacity: 0.25; } }
  .tv__news-run { flex: 1; min-width: 0; overflow: hidden; display: flex; align-items: center;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 1.2rem, #000 calc(100% - 1.6rem), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 1.2rem, #000 calc(100% - 1.6rem), transparent); }
  /* the run is in the track twice: scrolling it by half loops it seamlessly */
  .tv__news-track { display: flex; flex: none; white-space: nowrap; animation: newsRun var(--news-dur, 40s) linear infinite; }
  .tv__news-run:hover .tv__news-track,
  .tv.is-off .tv__news-track, .tv.is-contact .tv__news-track, .tv.is-ttx .tv__news-track, .tv.is-special .tv__news-track { animation-play-state: paused; }
  @keyframes newsRun { to { transform: translateX(-50%); } }
  .tv__news-track :global(.ni) { position: relative; display: inline-flex; align-items: center; gap: 0.6em; padding-right: 2.6rem; }
  .tv__news-track :global(.ni)::after { content: '■'; position: absolute; right: 1.15rem; font-size: 0.5em; color: rgba(242, 241, 234, 0.3); }
  .tv__news-track :global(.ni[data-tune]) { cursor: pointer; }
  .tv__news-track :global(.ni[data-tune]:hover .n-k) { color: var(--accent); }
  .tv__news-track :global(.n-d) { color: rgba(242, 241, 234, 0.58); }
  .tv__news-track :global(.n-up) { color: var(--accent); }
  .tv__news-track :global(.n-down) { color: #ff2e63; }
  .tv__news-track :global(.n-hl) { color: #f5c542; font-weight: 700; }

  /* changing channels: the picture rolls and splits */
  .tv__glass.is-roll .tv__img.is-top { animation: tvRoll 0.32s steps(4) 1; }
  @keyframes tvRoll {
    0% { transform: translateY(-18%); filter: drop-shadow(-6px 0 rgba(255, 46, 99, 0.8)) drop-shadow(6px 0 rgba(46, 230, 255, 0.8)) brightness(1.6); }
    40% { transform: translateY(9%) skewX(-4deg); }
    70% { transform: translateY(-3%); filter: drop-shadow(-2px 0 rgba(255, 46, 99, 0.6)) drop-shadow(2px 0 rgba(46, 230, 255, 0.6)); }
    100% { transform: none; filter: saturate(0.85) contrast(1.05); }
  }

  /* lower third: over the bottom of the picture */
  .tv__l3 { position: absolute; z-index: 3; left: 0; right: 0; bottom: var(--news-h); padding: 2.6rem 1.1rem 0.95rem;
    background: linear-gradient(transparent, rgba(8, 8, 8, 0.82) 38%, rgba(8, 8, 8, 0.94));
    pointer-events: none; }
  .tv__l3 a { pointer-events: auto; }
  .tv__title { display: flex; align-items: baseline; gap: 0.8rem; margin: 0 0 0.3rem;
    font: 700 clamp(1.05rem, 1.6vw, 1.35rem) var(--mono); letter-spacing: -0.01em; color: #f2f1ea; }
  .tv__year { font: 500 0.66rem var(--mono); letter-spacing: 0.18em; color: var(--muted); }
  /* three lines that fade out; hovering the screen opens it up to the whole text */
  .tv__desc { margin: 0 0 0.6rem; font: 0.76rem/1.6 var(--mono); color: var(--dim); max-width: 96ch;
    max-height: calc(1.6em * 3); overflow: hidden; transition: max-height 0.45s var(--ease-out);
    -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - 1.6em), transparent);
    mask-image: linear-gradient(180deg, #000 calc(100% - 1.6em), transparent); }
  .tv__desc.is-whole { -webkit-mask-image: none; mask-image: none; }
  .tv__descwrap { position: relative; }
  .tv__more { display: none; }
  .tv__read { position: absolute; inset: 0; z-index: 4; padding: 1rem 1.1rem; overflow: hidden;
    background: rgba(8, 8, 8, 0.93); font: 0.8rem/1.6 var(--mono); color: var(--fg); cursor: pointer; }
  .tv__read[hidden] { display: none; }
  .tv__read p { margin: 0 0 0.6rem; }
  .tv__read-x { font: 500 0.6rem var(--mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  @media (hover: hover) {
    .tv__screen:hover .tv__desc, .tv__screen:focus-within .tv__desc { max-height: calc(1.6em * 12);
      -webkit-mask-image: none; mask-image: none; }
  }
  /* one line, always: the stack gives way (…) before the buttons ever wrap */
  .tv__meta { display: flex; align-items: center; justify-content: space-between; gap: 0 1rem; }
  .tv__stack { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font: 500 0.64rem var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .tv__links { display: flex; gap: 0.45rem; flex: none; }
  .tv__btn { display: inline-flex; align-items: center; gap: 0.45em; padding: 0.38rem 0.7rem;
    border: 1px solid rgba(242, 241, 234, 0.22); background: rgba(10, 10, 10, 0.55);
    font: 500 0.62rem var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: #f2f1ea;
    transition: color var(--t-hover) ease, border-color var(--t-hover) ease, box-shadow var(--t-hover) ease; }
  .tv__btn[hidden] { display: none; }
  .tv__btn--go { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 50%, transparent); }
  .tv__btn:hover, .tv__btn:focus-visible { color: var(--accent); border-color: var(--accent); outline: none;
    box-shadow: 0 0 18px -6px var(--accent); }

  /* CH 00: the contact form over static */
  .tv__contact { position: absolute; z-index: 4; inset: 0; padding: 1rem 1.2rem; overflow: hidden;
    background: rgba(10, 10, 10, 0.6); display: flex; flex-direction: column; justify-content: center; }
  .tv__contact[hidden] { display: none; }
  .tv__contact-h { display: flex; justify-content: space-between; align-items: baseline; margin: 0 0 0.6rem;
    font: 700 1.05rem var(--mono); color: var(--fg); }
  .tv__x { background: none; border: 0; padding: 0; cursor: pointer; font: 500 0.62rem var(--mono);
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .tv__x:hover { color: var(--fg); }
  .tv.is-contact .tv__l3, .tv.is-contact .tv__osd .tv__state { visibility: hidden; }
  /* CH 00 has no picture: just a faint snow behind the form */
  .tv.is-contact .tv__img { opacity: 0 !important; }
  .tv.is-contact .tv__static { mix-blend-mode: normal; }

  /* ---- channels ---- */
  .tv__side { align-self: center; }
  .tv__list { list-style: none; border-bottom: 1px solid var(--line); }
  .tv__chbtn { display: grid; grid-template-columns: 2.2ch minmax(0, 1fr) auto; align-items: center; gap: 0 0.8rem;
    width: 100%; padding: 0.52rem 0.2rem; background: none; border: 0; border-top: 1px solid var(--line);
    cursor: pointer; text-align: left; font: 500 0.8rem var(--mono); color: var(--dim);
    transition: color var(--t-hover) ease, padding var(--t-hover) var(--ease-out); }
  .tv__chn { font-size: 0.66rem; color: var(--muted); }
  .tv__chname { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tv__dot { width: 5px; height: 5px; border-radius: 50%; background: var(--line); }
  .tv__dot[data-s="live"] { background: var(--accent); box-shadow: 0 0 6px var(--accent); }
  .tv__dot[data-s="download"] { background: var(--dim); }
  .tv__dot[data-s="in progress"] { background: #f5c542; box-shadow: 0 0 6px rgba(245, 197, 66, 0.6); }
  .tv__chbtn:hover, .tv__chbtn:focus-visible { color: var(--fg); padding-left: 0.6rem; outline: none; }
  .tv__chbtn.is-on { color: var(--fg); padding-left: 0.6rem; }
  .tv__chbtn.is-on .tv__chn { color: var(--accent); }
  .tv__chbtn.is-locked .tv__chname::after { content: '  ●'; color: var(--accent); font-size: 0.6em; vertical-align: 0.2em; }

  .tv__nav { display: none; }

  /* the remote under the channels */
  .tv__remote { display: flex; align-items: center; gap: 0.45rem; margin-top: 0.9rem; }
  .tv__rbtn { background: none; border: 1px solid var(--line); padding: 0.32rem 0.6rem; cursor: pointer; color: var(--fg);
    font: 500 0.62rem var(--mono); letter-spacing: 0.14em; text-transform: uppercase;
    transition: color var(--t-hover) ease, border-color var(--t-hover) ease; }
  .tv__rbtn:hover, .tv__rbtn:focus-visible, .tv__rbtn[aria-pressed="true"] { color: var(--accent); border-color: var(--accent); outline: none; }
  .tv__keys { margin-left: auto; font: 500 0.58rem var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }

  .tv__glass { touch-action: manipulation; } /* a double-tap doesn't zoom */

  /* ---- the channels that aren't in the list ---- */
  .tv__special { position: absolute; inset: 0; z-index: 2; overflow: hidden; }
  .tv__special[hidden] { display: none; }
  .tv.is-special .tv__img, .tv.is-special .tv__fill { opacity: 0 !important; }
  .tv.is-special .tv__links, .tv.is-ttx .tv__links { visibility: hidden; }
  /* no signal: the colour bars */
  .tv__special :global(.sp-bars) { position: absolute; inset: 0; display: grid; grid-template-rows: 66% 8% 26%; }
  .tv__special :global(.sp-bars > div) { display: grid; grid-template-columns: repeat(7, 1fr); }
  .tv__special :global(.sp-bars > div:last-child) { grid-template-columns: 5fr 5fr 5fr 15fr; }
  .tv__special :global(.sp-label) { position: absolute; left: 50%; top: 38%; translate: -50% -50%; margin: 0;
    padding: 0.45rem 1rem; background: #000; color: #fff; font: 700 clamp(0.8rem, 1.6vw, 1.1rem) var(--mono); letter-spacing: 0.24em; }
  /* 42: the answer */
  .tv__special :global(.sp-donut) { position: absolute; inset: 0; display: grid; place-items: center; background: #020b07; margin: 0;
    color: #3ad29f; font: 700 var(--fs, 9px)/1 var(--mono); white-space: pre; text-shadow: 0 0 6px rgba(58, 210, 159, 0.6); }
  /* 13 */
  .tv__special :global(.sp-horror) { position: absolute; inset: 0; display: grid; place-items: center; margin: 0;
    background: radial-gradient(circle, #3a0008, #000 72%); color: #ff2e63; text-align: center;
    font: 700 clamp(0.9rem, 2.4vw, 1.7rem) var(--mono); letter-spacing: 0.12em; text-shadow: 0 0 14px #ff0033;
    animation: spFlick 0.11s steps(2) infinite; }
  @keyframes spFlick { 50% { opacity: 0.55; transform: translateX(2px); } }
  /* the ad break */
  .tv__special :global(.sp-ad) { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.6rem; padding: 1rem 1rem 34%; text-align: center; cursor: pointer; /* clear of the lower third */
    background: repeating-linear-gradient(45deg, #ffd400 0 24px, #ff2e63 24px 48px); }
  .tv__special :global(.sp-ad b) { background: #000; color: #ffd400; padding: 0.3rem 0.8rem; rotate: -2deg;
    font: 700 clamp(1rem, 2.8vw, 1.9rem)/1.15 var(--mono); }
  .tv__special :global(.sp-ad span) { background: #fff; color: #000; padding: 0.25rem 0.7rem; letter-spacing: 0.12em;
    font: 700 clamp(0.62rem, 1.2vw, 0.8rem) var(--mono); animation: spBlink 0.5s steps(1) infinite; }
  @keyframes spBlink { 50% { opacity: 0; } }

  /* ---- teletext ---- */
  .tv__ttx { position: absolute; inset: 0; z-index: 4; background: #000; overflow: hidden; }
  .tv__ttx[hidden] { display: none; }
  .tv.is-ttx .tv__l3, .tv.is-ttx .tv__osd { visibility: hidden; }
  /* sized to a 46 × 19 grid with room around it, lit like phosphor */
  .tv__ttx-in { position: absolute; inset: 1.1em 1.3em; font: 600 var(--ttx, 13px)/1.22 var(--mono); color: #fff;
    letter-spacing: 0.02em; text-shadow: 0 0 0.4em rgba(255, 255, 255, 0.22); }
  .tv__ttx-in :global(.tr) { display: block; min-height: 1.22em; white-space: pre; overflow: hidden; }
  .tv__ttx-in :global(.tr[data-ttx-head]) { margin-bottom: 0.7em; opacity: 0.9; }
  .tv__ttx-in :global(.tr.dh) { font-size: 1.55em; line-height: 1.15; font-weight: 700; letter-spacing: 0.06em; margin-bottom: 0.35em; }
  /* a row of mosaic blocks under the double-height titles, in their colour */
  .tv__ttx-in :global(.tr.dh:not(.bg-b) > span:first-child::after) { content: ''; display: block; height: 0.14em; margin-top: 0.18em; width: 60%;
    background: repeating-linear-gradient(90deg, currentColor 0 0.42em, transparent 0.42em 0.56em); opacity: 0.55; }
  .tv__ttx-in :global(.tr.bg-b) { padding: 0.1em 0.4em; margin: 0 -0.4em 0.35em; }
  .tv__ttx-in :global(.tr[data-go]) { cursor: pointer; }
  .tv__ttx-in :global(.tr[data-go]:hover) { background: #0000ff; }
  .tv__ttx-in :global(.k-w) { color: #fff; } .tv__ttx-in :global(.k-y) { color: #ffff00; }
  .tv__ttx-in :global(.k-c) { color: #00ffff; } .tv__ttx-in :global(.k-g) { color: #00ff00; }
  .tv__ttx-in :global(.k-r) { color: #ff3b3b; } .tv__ttx-in :global(.k-m) { color: #ff00ff; }
  .tv__ttx-in :global(.bg-b) { background: #0000ff; }
  .tv__ttx-in :global(.fast) { position: absolute; left: 0; right: 0; bottom: 0; display: flex; gap: 0.6em;
    padding-top: 0.45em; border-top: 1px solid rgba(255, 255, 255, 0.12); }
  .tv__ttx-in :global(.fast span) { flex: 1; cursor: pointer; }
  .tv__ttx-in :global(.fast span:hover) { text-decoration: underline; }

  /* volume on screen */
  .tv__vol { position: absolute; z-index: 6; left: 50%; bottom: 24%; translate: -50% 0; margin: 0; padding: 0.35rem 0.85rem;
    background: rgba(0, 0, 0, 0.75); color: var(--accent); font: 700 0.9rem var(--mono); letter-spacing: 0.06em;
    opacity: 0; pointer-events: none; white-space: nowrap; }

  /* ---- phones: full-width screen, details under it, ◀ ▶ and swipe ---- */
  @media (max-width: 720px) {
    .tv { display: block; height: auto; }
    .tv__side { display: none; }
    .tv__screen { width: 100%; height: auto; }
    .tv { --news-h: 1.35rem; }
    .tv__news { font-size: 0.56rem; }
    .tv__news-tag { padding: 0 0.55rem; }
    .tv__glass { position: relative; inset: auto; aspect-ratio: 16 / 10; }
    .tv__screen[style*="--tv-gh"] .tv__glass { aspect-ratio: auto; height: var(--tv-gh); } /* squeezed by fitPhone() */
    .tv__l3 { position: static; padding: 0.9rem 0 0; background: none; pointer-events: auto; }
    .tv__desc { max-height: calc(1.6em * 3); min-height: calc(1.6em * 3); margin-bottom: 0.95rem; } /* steady height across channels */
    .tv__meta { min-height: 2.05rem; } /* the link buttons' height, even in standby */
    .tv__nav { display: flex; align-items: center; justify-content: space-between; margin-top: 0.7rem;
      font: 500 0.66rem var(--mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
    .tv__navn b { color: var(--fg); font-weight: 500; }
    .tv__navbtn { background: none; border: 1px solid var(--line); padding: 0.45rem 0.9rem; color: var(--fg);
      font: inherit; cursor: pointer; }
    .tv__navbtn:active { transform: translateY(1px); }
    .tv__navbtn--sm { padding: 0.45rem 0.55rem; font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; }
    .tv__navbtn--sm[aria-pressed="true"] { color: var(--accent); border-color: var(--accent); }
    .tv__navn { margin-right: auto; margin-left: 0.6rem; }
    .tv.is-contact .tv__l3, .tv.is-contact .tv__nav { display: none; }
    .tv__more:not([hidden]) { display: block; position: absolute; right: 0; bottom: 0; padding: 0 0 0 1.4rem;
      background: linear-gradient(90deg, transparent, var(--bg) 1.2rem); border: 0; cursor: pointer;
      font: 500 0.7rem/1.6 var(--mono); color: var(--accent); }
    .tv__contact { position: static; inset: auto; padding: 0.9rem 0 0; background: none; }
    .tv.is-contact .tv__screen { display: flex; flex-direction: column; }
    .tv.is-contact .tv__glass { aspect-ratio: auto; height: auto; flex: 1 1 3.2rem; min-height: 3.2rem; }
  }
  @media (max-width: 720px) and (max-height: 700px) { .tv__desc { max-height: calc(1.6em * 2); min-height: calc(1.6em * 2); } }

  @media (prefers-reduced-motion: reduce) {
    .tv__glass { transition: none; }
    .tv__glass.is-roll .tv__img.is-top { animation: none; }
    .tv__chbtn, .tv__btn { transition: none; }
    .tv__news-track, .tv__news-tag::before { animation: none; } /* one headline at a time instead (script) */
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { sound } from '../scripts/sound';
  import { leet, achievements } from '../scripts/eggs';
  import { newsItems, newsHTML } from '../scripts/news';
  import { activity, pings } from '../scripts/feed';
  import type { Activity } from '../scripts/activity';
  import type { Ping } from '../scripts/status';
  import { afterLoader } from '../scripts/loaded';
  import { onPage, every } from '../scripts/page';
  import { navigate } from 'astro:transitions/client';
  import { edges, glow } from '../scripts/ambilight';
  import { timeIn, doing, hhmm, apart } from '../scripts/mytime';
  import { channelFor, remoteDigit, remoteLabel, volumeBar, clampVolume, teletextHTML, esc, TXT_HOME, type TxtContext } from '../scripts/tv';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isPhone = () => matchMedia('(max-width: 720px)').matches;

  // the set is built on every visit to its page and taken down when you leave
  // it (scripts/page.ts): every window/document listener carries the signal
  onPage((signal) => {
    const root = document.querySelector<HTMLElement>('[data-tv]');
    if (!root) return;
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const screen = $('[data-tv-screen]');
    const glass = $('[data-tv-glass]');
    const pic = $('[data-tv-pic]');
    const imgs = Array.from(root.querySelectorAll<HTMLImageElement>('[data-tv-img]'));
    const fill = $<HTMLImageElement>('[data-tv-fill]');
    const staticCv = $<HTMLCanvasElement>('[data-tv-static]');
    const hit = $<HTMLAnchorElement>('[data-tv-hit]');
    const chEl = $('[data-tv-ch]');
    const stateEl = $('[data-tv-state]');
    const big = $('[data-tv-big]');
    const bar = $('[data-tv-bar]');
    const titleEl = $('[data-tv-title]');
    const yearEl = $('[data-tv-year]');
    const descEl = $('[data-tv-desc]');
    const stackEl = $('[data-tv-stack]');
    const live = $<HTMLAnchorElement>('[data-tv-live]');
    const download = $<HTMLAnchorElement>('[data-tv-download]');
    const repo = $<HTMLAnchorElement>('[data-tv-repo]');
    const nEl = $('[data-tv-n]');
    const moreBtn = $<HTMLButtonElement>('[data-tv-more]');
    const readBox = $('[data-tv-read]');
    const readT = $('[data-tv-read-t]');
    const contact = $('[data-tv-contact]');
    const chans = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ch]'));
    const avail = document.querySelector<HTMLButtonElement>('[data-contact-open]');
    const pad = (n: number) => String(n).padStart(2, '0');
    const say = (t: string) => (document.documentElement.classList.contains('egg-leet') ? leet(t) : t);

    // ---- size: as big as the room allows, always 16:10 ----
    function fit() {
      if (isPhone()) { screen.style.removeProperty('--tv-w'); screen.style.removeProperty('--tv-h'); fitPhone(); return; }
      screen.style.removeProperty('--tv-gh');
      const side = root!.querySelector<HTMLElement>('.tv__side')!;
      const gap = parseFloat(getComputedStyle(root!).columnGap) || 32;
      const w = root!.clientWidth - side.offsetWidth - gap;
      const h = root!.clientHeight - 12;
      const W = Math.max(240, Math.min(w, h * 1.6));
      screen.style.setProperty('--tv-w', `${Math.round(W)}px`);
      screen.style.setProperty('--tv-h', `${Math.round(W / 1.6)}px`);
    }
    // phones stack everything in one column: when it's taller than the screen
    // (short phones, a browser's toolbars), the picture gives up height — down
    // to a 2.5:1 crop — so the links never run into the frame
    function fitPhone() {
      if (root!.classList.contains('is-contact')) return; // the form changes the stack; keep the last fit
      const page = root!.closest<HTMLElement>('.page');
      if (!page) return;
      screen.style.removeProperty('--tv-gh');
      const cs = getComputedStyle(page);
      const room = page.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
      const used = Array.from(page.children).reduce((sum, el) => {
        if (el.classList.contains('spacer')) return sum;
        const m = getComputedStyle(el);
        return sum + (el as HTMLElement).offsetHeight + parseFloat(m.marginTop) + parseFloat(m.marginBottom);
      }, 0);
      const over = used - room;
      if (over <= 0) return;
      const w = glass.clientWidth;
      screen.style.setProperty('--tv-gh', `${Math.round(Math.max(w / 2.5, w / 1.6 - over))}px`);
    }
    fit();
    let fitT = 0;
    addEventListener('resize', () => { clearTimeout(fitT); fitT = window.setTimeout(fit, 80); }, { signal });
    document.fonts.ready.then(fit);

    // ---- static: noise painted into a tiny canvas, scaled up ----
    const sx = staticCv.getContext('2d')!;
    const noise = sx.createImageData(staticCv.width, staticCv.height);
    let staticRaf = 0, staticUntil = 0;
    const paintStatic = () => {
      const d = noise.data;
      for (let i = 0; i < d.length; i += 4) { const v = (Math.random() * 255) | 0; d[i] = d[i + 1] = d[i + 2] = v; d[i + 3] = 255; }
      sx.putImageData(noise, 0, 0);
      if (performance.now() < staticUntil || root.classList.contains('is-contact')) staticRaf = requestAnimationFrame(paintStatic);
      else { staticRaf = 0; staticCv.style.opacity = '0'; }
    };
    const burst = (ms: number, level = 0.85) => {
      if (reduce) return;
      staticUntil = performance.now() + ms;
      staticCv.style.opacity = String(level);
      gsap.to(staticCv, { opacity: 0, duration: ms / 1000, ease: 'power2.in', delay: 0.05 });
      if (!staticRaf) staticRaf = requestAnimationFrame(paintStatic);
    };

    // ---- tuning ----
    let shown = -1, locked: number | null = null, hovering = false, top = 0;
    let on = false, powering = false, pending = 0;
    let afterOn: (() => void) | null = null;
    const line = $('[data-tv-line]');
    const ember = $('[data-tv-ember]');

    // the title's decode animation — whoever writes the title next cancels it
    let decodeIv = 0;
    const warmed = new Set<number>(); // covers already fetched (see warm())

    // standby: what the screen says before it's switched on
    function paintStandby() {
      clearInterval(decodeIv);
      chEl.textContent = 'CH --';
      stateEl.textContent = 'standby';
      stateEl.dataset.s = 'off';
      titleEl.textContent = 'standby';
      yearEl.textContent = '';
      descEl.textContent = isPhone()
        ? `${chans.length} channels of things I've built — swipe the screen or tap ▶ to tune in.`
        : `${chans.length} channels of things I've built — pick one to tune in.`;
      descEl.classList.add('is-whole');
      moreBtn.hidden = true;
      stackEl.textContent = '';
      [live, download, repo].forEach((a) => { a.hidden = true; });
      hit.removeAttribute('href');
      nEl.textContent = '--';
      chans.forEach((c) => c.classList.remove('is-on'));
    }

    // switch on, CRT style: the picture collapses to a bright line and opens out
    function powerOn(i: number | (() => void)) {
      if (typeof i === 'function') {
        if (on) { i(); return; }
        afterOn = i;
        i = shown >= 0 ? shown : 0;
      }
      pending = i;
      if (on) { if (!powering) tune(i); return; }
      on = true;
      root!.classList.remove('is-off');
      gsap.killTweensOf(ember);
      gsap.set(ember, { opacity: 0 });
      sound.glitch();
      const then = () => { const f = afterOn; afterOn = null; if (f) f(); else tune(pending, true); };
      if (reduce) { then(); surf(); return; }
      powering = true;
      // explicit from-values: tweened from the computed one ("inset(50% 0px)", two
      // values) the four didn't pair up and the picture opened from the top only
      gsap.timeline({ onComplete: () => { powering = false; surf(); } })
        .set(pic, { clipPath: 'inset(50% 0% 50% 0%)' })
        .fromTo(line, { scaleX: 0, opacity: 1 }, { scaleX: 1, duration: 0.2, ease: 'power3.out' })
        .add(then)
        .fromTo(pic, { clipPath: 'inset(50% 0% 50% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.42, ease: 'power3.out' })
        .to(line, { opacity: 0, duration: 0.3, ease: 'power2.out' }, '<')
        .add(() => { burst(260, 0.5); })
        .set(pic, { clearProps: 'clipPath' });
    }
    const data = (i: number) => chans[i].dataset;

    function paintDetails(i: number) {
      clearInterval(decodeIv);
      const d = data(i);
      chEl.textContent = `CH ${pad(i + 1)}`;
      stateEl.textContent = d.status || 'personal';
      stateEl.dataset.s = d.status || '';
      titleEl.textContent = say(d.title || '');
      yearEl.textContent = d.year || '';
      descEl.textContent = say(d.desc || '');
      readBox.hidden = true;
      requestAnimationFrame(() => {
        const whole = descEl.scrollHeight <= descEl.clientHeight + 1;
        descEl.classList.toggle('is-whole', whole);
        moreBtn.hidden = whole || !isPhone(); // desktop opens it on hover instead
      });
      stackEl.textContent = d.tags || '';
      ([[live, d.live], [download, d.download], [repo, d.repo]] as const).forEach(([a, href]) => {
        if (href) { a.href = href; a.hidden = false; } else a.hidden = true;
      });
      const main = d.live || d.download || d.repo || '';
      if (main) { hit.href = main; } else hit.removeAttribute('href');
      nEl.textContent = pad(i + 1);
      chans.forEach((c, k) => c.classList.toggle('is-on', k === i));
      // the title decodes in, like everything else here
      if (!reduce) {
        const truth = say(d.title || '');
        const G = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#%&*';
        let f = 0;
        decodeIv = window.setInterval(() => {
          const lock = Math.floor((f++ / 9) * truth.length);
          titleEl.textContent = truth.split('').map((c, k) => (k < lock || c === ' ' ? c : G[(Math.random() * G.length) | 0])).join('');
          if (lock >= truth.length) { clearInterval(decodeIv); titleEl.textContent = truth; }
        }, 32);
      }
    }

    // ambilight: the cover, shrunk to a few pixels, gives each edge its glow
    const ambCx = Object.assign(document.createElement('canvas'), { width: 32, height: 20 })
      .getContext('2d', { willReadFrequently: true });
    function ambient(img: HTMLImageElement) {
      if (!ambCx || !img.naturalWidth) return;
      try {
        ambCx.drawImage(img, 0, 0, 32, 20);
        const [l, t, r, b] = edges(ambCx.getImageData(0, 0, 32, 20).data, 32, 20).map((c) => glow(c));
        Object.entries({ l, t, r, b }).forEach(([k, v]) => root!.style.setProperty(`--amb-${k}`, v));
      } catch { /* an unreadable picture: the glow stays as it was */ }
    }

    function tune(i: number, quiet = false) {
      i = (i + chans.length) % chans.length;
      const covered = clearOverlays();
      if (i === shown) { if (covered) paintDetails(i); return; }
      shown = i;
      const d = data(i);
      // the next picture loads into the back layer, then swaps to the front
      const next = imgs[1 - top];
      const swap = () => {
        const ratio = next.naturalWidth / next.naturalHeight || 1.6;
        const letterbox = Math.abs(ratio - 1.6) / 1.6 > 0.06;
        next.classList.toggle('is-contain', letterbox);
        fill.classList.toggle('is-on', letterbox);
        if (letterbox) fill.src = next.src;
        imgs[top].classList.remove('is-top');
        next.classList.add('is-top');
        top = 1 - top;
        ambient(next);
        glass.classList.remove('is-roll');
        void glass.offsetWidth;
        glass.classList.add('is-roll');
      };
      next.onload = next.onerror = null; // a stale handler would swap twice
      if (d.cover) { next.src = d.cover; if (next.complete) swap(); else next.onload = swap; }
      warm(i + 1); warm(i - 1); // the neighbours, for ◀ ▶ and the surf
      paintDetails(i);
      if (quiet) return;
      burst(260);
      sound.glitch();
      if (!reduce) {
        big.textContent = `CH ${pad(i + 1)}`;
        gsap.fromTo(big, { opacity: 1 }, { opacity: 0, duration: 0.5, delay: 0.25, ease: 'steps(3)' });
      }
    }

    // ---- left alone, it channel-surfs ----
    const ATTRACT = 7;
    let attract: gsap.core.Tween | null = null;
    let hops = 0, adT = 0;
    function surf() {
      attract?.kill();
      if (!on || reduce || locked !== null || hovering || root!.classList.contains('is-contact') || root!.classList.contains('is-ttx')
        || (root!.classList.contains('is-special') && specialKind !== 'ad')) { gsap.set(bar, { scaleX: 0 }); return; }
      attract = gsap.fromTo(bar, { scaleX: 0 }, { scaleX: 1, duration: ATTRACT, ease: 'none',
        onComplete: () => {
          if (document.hidden) { surf(); return; }
          // every fourth hop: a word from our sponsor
          if (++hops % 4 === 0) {
            special('ad');
            adT = window.setTimeout(() => { if (root!.classList.contains('is-special')) tune(shown + 1); surf(); }, 4500);
            return;
          }
          tune(shown + 1);
          surf();
        } });
    }

    const lock = (i: number | null) => {
      locked = i;
      chans.forEach((c, k) => c.classList.toggle('is-locked', k === i));
      surf();
    };

    // desktop: hover previews, click locks (click the locked one again to let it surf)
    chans.forEach((c, i) => {
      // hovering only highlights the row (a diagonal pass over the list used to
      // change channels by accident); a click tunes in and holds the channel —
      // click it again to let the set go back to surfing
      c.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') sound.tick(); });
      c.addEventListener('click', () => {
        closeContact();
        const again = locked === i && on && shown === i;
        powerOn(i);
        lock(again ? null : i);
      });
    });
    const list = $('[data-tv-list]');
    list.addEventListener('pointerenter', () => { hovering = true; surf(); });
    list.addEventListener('pointerleave', () => {
      hovering = false;
      surf();
    });
    // ↑ ↓ walk the channels from the list
    list.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      e.preventDefault();
      const k = (Math.max(0, shown) + (shown < 0 ? 0 : e.key === 'ArrowDown' ? 1 : -1) + chans.length) % chans.length;
      chans[k].focus();
      closeContact();
      powerOn(k);
      lock(k);
    });

    // phones: ◀ ▶ and a swipe on the screen; picking a channel locks it
    const step = (dir: number) => {
      closeContact();
      if (!on) { powerOn(dir > 0 ? 0 : chans.length - 1); lock(pending); return; }
      tune(shown + dir);
      lock(shown);
    };
    // a click (or tap) on the switched-off screen turns it on
    hit.addEventListener('click', (e) => {
      e.preventDefault();
      if (!on) { powerOn(0); return; }
      const href = hit.getAttribute('href');
      if (href && e.detail < 2) window.open(href, '_blank', 'noopener'); // a double-click opens it once
    });
    $('[data-tv-prev]').addEventListener('click', () => step(-1));
    $('[data-tv-next]').addEventListener('click', () => step(1));
    let tx = 0, ty = 0;
    glass.addEventListener('touchstart', (e) => { tx = e.touches[0].clientX; ty = e.touches[0].clientY; }, { passive: true });
    glass.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - tx, dy = e.changedTouches[0].clientY - ty;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.4) step(dx < 0 ? 1 : -1);
    }, { passive: true });

    // phones: "+ more" puts the whole description on the screen; a tap closes it
    moreBtn.addEventListener('click', () => {
      readT.textContent = descEl.textContent;
      readBox.hidden = false;
      if (!reduce) gsap.fromTo(readBox, { opacity: 0 }, { opacity: 1, duration: 0.25 });
      attract?.kill();
    });
    readBox.addEventListener('click', () => { readBox.hidden = true; surf(); });

    // ---- CH 00: contact ----
    const fields = Array.from(contact.querySelectorAll<HTMLElement>('[data-field]'));
    function openContact() {
      if (root!.classList.contains('is-contact')) return;
      readBox.hidden = true;
      clearOverlays();
      // phones: the form takes the details' place at the same height (the
      // static fills what's left), so nothing above it moves
      if (isPhone()) screen.style.height = `${screen.offsetHeight}px`;
      root!.classList.add('is-contact');
      contact.hidden = false;
      chEl.textContent = 'CH 00';
      chans.forEach((c) => c.classList.remove('is-on'));
      avail?.setAttribute('aria-expanded', 'true');
      attract?.kill();
      gsap.set(bar, { scaleX: 0 });
      sound.glitch();
      if (!reduce) {
        staticCv.style.opacity = '0.14';
        if (!staticRaf) staticRaf = requestAnimationFrame(paintStatic);
        big.textContent = 'CH 00';
        gsap.fromTo(big, { opacity: 1 }, { opacity: 0, duration: 0.5, delay: 0.25, ease: 'steps(3)' });
        gsap.fromTo(fields, { opacity: 0, y: 8 }, { opacity: 1, y: 0, stagger: 0.05, duration: 0.3, delay: 0.2, ease: 'power2.out' });
      } else gsap.set(fields, { opacity: 1, y: 0 });
      if (!isPhone()) setTimeout(() => contact.querySelector<HTMLElement>('input')?.focus({ preventScroll: true }), reduce ? 0 : 300);
    }
    // leaving CH 00 (any way out) wipes the form: next time it's blank
    function clearForm() {
      const form = contact.querySelector<HTMLFormElement>('form');
      if (!form) return;
      form.reset();
      form.classList.remove('is-tx');
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      const status = form.querySelector<HTMLElement>('[data-contact-status]');
      if (status) { status.textContent = ''; status.removeAttribute('data-state'); }
    }

    function closeContact() {
      if (!root!.classList.contains('is-contact')) return;
      clearForm();
      screen.style.removeProperty('height');
      root!.classList.remove('is-contact');
      contact.hidden = true;
      avail?.setAttribute('aria-expanded', 'false');
      if (!on) { paintStandby(); return; } // it was in standby before
      const i = shown;
      shown = -1;
      tune(i);
      surf();
    }
    avail?.addEventListener('click', () => (root.classList.contains('is-contact') ? closeContact() : openContact()));
    $('[data-tv-close]').addEventListener('click', () => { closeContact(); avail?.focus(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-contact')) { closeContact(); avail?.focus(); }
    }, { signal });
    addEventListener('nyhz:contact', openContact, { signal });
    // the terminal's `open <project>`
    addEventListener('nyhz:open', (e) => {
      const slug = (e as CustomEvent<{ slug: string }>).detail?.slug;
      const i = chans.findIndex((c) => c.dataset.slug === slug);
      if (i < 0) return;
      closeContact();
      powerOn(i);
      lock(i);
    }, { signal });
    // the l33t minute rewrites static text; the screen's text is set here
    addEventListener('nyhz:leet', () => setTimeout(() => { if (shown >= 0) paintDetails(shown); }, 300), { signal });
    document.addEventListener('visibilitychange', () => { if (document.hidden) attract?.pause(); else attract?.resume(); }, { signal });

    // covers are fetched as they're needed: the channel and its neighbours
    // (tune() warms those), not all of them up front
    function warm(i: number) {
      i = (i + chans.length) % chans.length;
      const src = chans[i]?.dataset.cover;
      if (!src || warmed.has(i)) return;
      warmed.add(i);
      const im = new Image(); im.decoding = 'async'; im.fetchPriority = 'low'; im.src = src;
    }
    // the first channel is where it switches on
    afterLoader(() => warm(0));

    // ===================== the remote and its channels =====================
    const txtCtx = JSON.parse(root.dataset.txt || '{}') as TxtContext;
    const special$ = $('[data-tv-special]');
    const ttx = $('[data-tv-ttx]');
    const ttxIn = $('[data-tv-ttx-in]');
    const vol = $('[data-tv-vol]');
    const txtBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tv-txt]'));
    const powerBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tv-power]'));
    const achieve = (id: string) => dispatchEvent(new CustomEvent('nyhz:achieve', { detail: { id } }));
    let specialKind: 'nosignal' | 'secret' | 'horror' | 'ad' | null = null;
    let specialRaf = 0;

    // put the screen back to the plain channel (or standby); true if anything was covering it
    function clearOverlays() {
      let had = false;
      if (root!.classList.contains('is-special')) {
        had = true;
        root!.classList.remove('is-special');
        special$.hidden = true;
        special$.replaceChildren();
        cancelAnimationFrame(specialRaf);
        clearTimeout(adT);
        specialKind = null;
      }
      if (root!.classList.contains('is-ttx')) {
        had = true;
        root!.classList.remove('is-ttx');
        ttx.hidden = true;
        clearInterval(ttxClock);
        txtBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      }
      return had;
    }
    const restore = () => { if (on && shown >= 0) paintDetails(shown); else paintStandby(); surf(); };

    // a lower third for the screens that aren't projects
    function caption(ch: string, title: string, desc: string) {
      clearInterval(decodeIv);
      chEl.textContent = ch;
      stateEl.textContent = '';
      stateEl.dataset.s = '';
      titleEl.textContent = title;
      yearEl.textContent = '';
      descEl.textContent = desc;
      descEl.classList.add('is-whole');
      moreBtn.hidden = true;
      stackEl.textContent = '';
      hit.removeAttribute('href');
      chans.forEach((c) => c.classList.remove('is-on'));
    }

    function special(kind: 'nosignal' | 'secret' | 'horror' | 'ad', n = 0) {
      const show = () => {
        clearOverlays();
        root!.classList.add('is-special');
        specialKind = kind;
        special$.hidden = false;
        burst(300);
        sound.glitch();
        if (kind === 'nosignal') {
          const bars = [
            ['#c0c0c0', '#c0c000', '#00c0c0', '#00c000', '#c000c0', '#c00000', '#0000c0'],
            ['#0000c0', '#131313', '#c000c0', '#131313', '#00c0c0', '#131313', '#c0c0c0'],
            ['#00214c', '#ffffff', '#32006a', '#131313'],
          ];
          special$.innerHTML = `<div class="sp-bars">${bars.map((r) => `<div>${r.map((c) => `<i style="background:${c}"></i>`).join('')}</div>`).join('')}</div><p class="sp-label">NO SIGNAL</p>`;
          caption(`CH ${String(n).padStart(2, '0')}`, 'no signal', `there's nothing on channel ${String(n).padStart(2, '0')}. there are ${chans.length} channels — or are there?`);
          sound.beep(1.4);
          achieve('channel');
        } else if (kind === 'secret') {
          const pre = document.createElement('pre');
          pre.className = 'sp-donut';
          special$.append(pre);
          donut(pre);
          caption('CH 42', 'the answer', "channel 42. you weren't supposed to find this. don't panic.");
          achieve('channel');
        } else if (kind === 'horror') {
          special$.innerHTML = `<p class="sp-horror">don't look<br/>behind you</p>`;
          caption('CH 13', '▓▒░ ▒▓▒ ░▓', 'channel 13 is not available in your region.');
          dispatchEvent(new Event('nyhz:glitch'));
          const html = document.documentElement;
          html.classList.remove('egg-broken');
          void html.offsetWidth;
          html.classList.add('egg-broken');
          setTimeout(() => html.classList.remove('egg-broken'), 1150);
          achieve('channel');
        } else {
          special$.innerHTML = '<div class="sp-ad" role="button" tabindex="0"><b>TIRED OF BORING<br/>WEBSITES?</b><span>☎ CALL NOW · OPERATORS STANDING BY</span></div>';
          special$.querySelector('.sp-ad')?.addEventListener('click', () => openContact());
          caption('AD', 'commercial break', 'a word from our sponsor: nyhz reads every message. click to call.');
        }
      };
      if (!on) powerOn(show); else show();
    }

    // CH 42: the classic spinning ascii donut (a1k0n's donut.c), in green
    function donut(pre: HTMLElement) {
      const W = 44, H = 22;
      let A = 1, B = 1, last = 0;
      pre.style.setProperty('--fs', `${Math.max(6, Math.min(glass.clientWidth / (W * 0.62), glass.clientHeight / (H * 1.02)))}px`);
      const frame = (t: number) => {
        if (t - last > 50) {
          last = t;
          const b: string[] = new Array(W * H).fill(' ');
          const z: number[] = new Array(W * H).fill(0);
          const cA = Math.cos(A), sA = Math.sin(A), cB = Math.cos(B), sB = Math.sin(B);
          for (let j = 0; j < 6.28; j += 0.07) {
            const ct = Math.cos(j), st = Math.sin(j);
            for (let i = 0; i < 6.28; i += 0.02) {
              const sp = Math.sin(i), cp = Math.cos(i), h = ct + 2;
              const D = 1 / (sp * h * sA + st * cA + 5);
              const tt = sp * h * cA - st * sA;
              const x = (W / 2 + (W * 0.36) * D * (cp * h * cB - tt * sB)) | 0;
              const y = (H / 2 + (H * 0.6) * D * (cp * h * sB + tt * cB)) | 0;
              const o = x + W * y;
              const N = (8 * ((st * sA - sp * ct * cA) * cB - sp * ct * sA - st * cA - cp * ct * sB)) | 0;
              if (y >= 0 && y < H && x >= 0 && x < W && D > z[o]) { z[o] = D; b[o] = '.,-~:;=!*#$@'[N > 0 ? N : 0]; }
            }
          }
          let out = '';
          for (let k = 0; k < H; k++) out += b.slice(k * W, k * W + W).join('') + '\n';
          pre.textContent = out;
          A += 0.07; B += 0.03;
        }
        specialRaf = requestAnimationFrame(frame);
      };
      specialRaf = requestAnimationFrame(frame);
    }

    // ---- the number keys: type a channel (or a teletext page) ----
    let digits = '', digitT = 0;
    function tuneNumber(n: number) {
      const c = channelFor(n, chans.length);
      // a clicked channel keeps focus, and once keys are typed :focus-visible
      // keeps it indented: focus follows the channel, or lets go of the list
      const held = chans.find((b) => b === document.activeElement);
      if (held && !(c.kind === 'project' && chans[c.index] === held)) {
        if (c.kind === 'project') chans[c.index].focus({ preventScroll: true }); else held.blur();
      }
      if (c.kind === 'project') {
        closeContact();
        if (on && c.index === shown && !root!.classList.contains('is-special')) paintDetails(shown); // same channel: just clear "CH 0_"
        powerOn(c.index);
        lock(c.index);
      }
      else if (c.kind === 'contact') openContact();
      else { closeContact(); lock(null); special(c.kind, c.kind === 'nosignal' ? c.n : 0); }
    }
    // ---- the news ticker ----
    // Real headlines (scripts/news.ts) scrolling along the bottom of the
    // picture. New data never jumps the strip: while it's on screen, changes
    // wait for the end of the lap, where the loop is back at its start.
    const news = $('[data-tv-news]');
    const newsTrack = $('[data-tv-news-track]');
    const newsRun = newsTrack.parentElement!;
    const feed: { pings: Ping[] | null; activity: Activity | null } = { pings: null, activity: null };
    const newsProjects = chans.map((c) => ({
      slug: c.dataset.slug || '', title: c.dataset.title || '', status: c.dataset.status || '', repo: c.dataset.repo || '',
    }));
    const NEWS_SPEED = isPhone() ? 42 : 55; // px per second
    const myClock = () => {
      const t = timeIn(new Date());
      return { time: hhmm(t), doing: doing(t.h, t.day), apart: apart(t.offset, -new Date().getTimezoneOffset()) };
    };
    const headlines = () => newsItems({
      projects: newsProjects, ...feed, found: achievements().count(), total: achievements().total,
      location: txtCtx.location, touch: matchMedia('(hover: none)').matches, now: Date.now(), clock: myClock(),
    });
    const newsOnScreen = () => getComputedStyle(news).visibility === 'visible';
    let newsRz = 0;
    let newsHtml = '', newsAt = 0;
    function paintNews() {
      const items = headlines();
      if (reduce) { // no scrolling: one headline at a time
        newsAt %= items.length;
        newsTrack.innerHTML = newsHTML([items[newsAt]], say);
        return;
      }
      const html = newsHTML(items, say);
      if (html === newsHtml) return;
      newsHtml = html;
      // enough laps of the headlines to fill the strip, then all of it twice
      newsTrack.innerHTML = html;
      const lap = newsTrack.scrollWidth || 1;
      const half = html.repeat(Math.max(1, Math.ceil(newsRun.clientWidth / lap)));
      newsTrack.innerHTML = half + half;
      newsTrack.style.setProperty('--news-dur', `${(newsTrack.scrollWidth / 2 / NEWS_SPEED).toFixed(1)}s`);
      newsTrack.style.animation = 'none'; // restart from the top of the loop
      void newsTrack.offsetWidth;
      newsTrack.style.removeProperty('animation');
    }
    // new data: straight in while nobody's watching, otherwise at the end of the lap
    const freshNews = () => { if (reduce || !newsOnScreen()) paintNews(); };
    newsTrack.addEventListener('animationiteration', paintNews); // also keeps "2h ago" current
    if (reduce) every(5000, () => { newsAt++; paintNews(); }, signal);
    paintNews();
    // the widths change with the fonts and the window: measure again
    const remeasure = () => { newsHtml = ''; freshNews(); };
    document.fonts.ready.then(remeasure);
    addEventListener('resize', () => { clearTimeout(newsRz); newsRz = window.setTimeout(remeasure, 150); }, { signal });
    afterLoader(() => {
      activity().then((a) => { feed.activity = a; freshNews(); });
      const poll = () => {
        if (document.hidden) return;
        pings().then((p) => { feed.pings = p; freshNews(); });
      };
      poll();
      every(120_000, poll, signal);
    });
    // a secret found, the l33t minute: the headlines change with them
    addEventListener('nyhz:achieve', () => setTimeout(freshNews), { signal });
    addEventListener('nyhz:leet', () => setTimeout(freshNews, 300), { signal });
    // a headline about a project tunes to it
    news.addEventListener('click', (e) => {
      const ch = (e.target as HTMLElement).closest<HTMLElement>('[data-tune]')?.dataset.tune;
      if (ch !== undefined) tuneNumber(Number(ch) + 1);
    });

    const typing = (e: KeyboardEvent) => !!(e.target as HTMLElement | null)?.closest?.('input, textarea, [contenteditable]')
      || e.metaKey || e.ctrlKey || e.altKey
      || !!document.querySelector('.term.is-open') || document.documentElement.classList.contains('egg-game')
      || !!document.querySelector('[data-cert]:not([hidden])');
    addEventListener('keydown', (e) => {
      if (typing(e) || isPhone()) return;
      const k = e.key;
      if (/^[0-9]$/.test(k)) {
        const inTtx = root!.classList.contains('is-ttx');
        const max = inTtx ? 3 : 2;
        const r = remoteDigit(digits, k, max);
        digits = r.buffer;
        clearTimeout(digitT);
        if (inTtx) { ttxHeader(`P${remoteLabel(digits, 3)}`); }
        else chEl.textContent = `CH ${remoteLabel(digits)}`;
        const go = () => {
          const n = Number(digits);
          digits = '';
          if (inTtx) page(n); else tuneNumber(n);
        };
        if (r.ready) go(); else digitT = window.setTimeout(go, inTtx ? 1500 : 1000);
        return;
      }
      if (k === 't' || k === 'T') { toggleTtx(); return; }
      if (k === '+' || k === '=' || k === '-' || k === '_') { volumeStep(k === '+' || k === '=' ? 1 : -1); return; }
      if (root!.classList.contains('is-ttx')) {
        if (k === 'Escape') { e.preventDefault(); toggleTtx(false); }
        else if (k === 'ArrowRight' || k === 'ArrowLeft') { e.preventDefault(); stepPage(k === 'ArrowRight' ? 1 : -1); }
      } else if (k === 'Escape' && root!.classList.contains('is-special')) { clearOverlays(); restore(); }
    }, { signal });

    // ---- volume: + / − on the remote ----
    let volT = 0;
    function volumeStep(dir: number) {
      const level = clampVolume(sound.level + dir);
      sound.volume(level);
      vol.textContent = volumeBar(level);
      gsap.killTweensOf(vol);
      gsap.set(vol, { opacity: 1 });
      clearTimeout(volT);
      volT = window.setTimeout(() => gsap.to(vol, { opacity: 0, duration: 0.3 }), 1300);
    }

    // ---- teletext ----
    let ttxPage = TXT_HOME, ttxClock = 0, ttxLabel = '';
    const PAGES = [100, 101, 102, 103, 104, 105, 888];
    function ttxHeader(label?: string) {
      if (label !== undefined) ttxLabel = label;
      const h = ttxIn.querySelector('[data-ttx-head]');
      if (!h) return;
      const d = new Date();
      const p = (x: number) => String(x).padStart(2, '0');
      const day = d.toLocaleDateString('en-GB', { weekday: 'short', day: '2-digit', month: 'short' }).replace(',', '');
      h.innerHTML = `<span class="k-w">${esc(ttxLabel.padEnd(5))}</span> <span class="k-c">NYHZ TEXT</span> <span class="k-w">${ttxPage}</span> <span class="k-y">${esc(day)} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}</span>`;
    }
    function page(n: number) {
      ttxPage = n;
      ttxIn.innerHTML = `<span class="tr" data-ttx-head></span>${teletextHTML(n, txtCtx)}`;
      ttxHeader(`P${n}`);
    }
    function stepPage(dir: number) {
      const i = PAGES.indexOf(ttxPage);
      page(PAGES[(i < 0 ? 0 : i + dir + PAGES.length) % PAGES.length]);
    }
    ttxIn.addEventListener('click', (e) => {
      const go = (e.target as HTMLElement).closest<HTMLElement>('[data-go]')?.dataset.go;
      if (!go) return;
      if (go[0] === 'p') page(Number(go.slice(1)));
      else if (go[0] === 'u') navigate(go.slice(1)); // a page off the tv (the making of), through the router
      else { toggleTtx(false); tuneNumber(Number(go.slice(1))); }
    });
    // fit teletext's 40 columns into whatever size the screen is
    const fitTtx = () => ttxIn.style.setProperty('--ttx',
      `${Math.max(6.5, Math.min(glass.clientWidth / (46 * 0.62), glass.clientHeight / (19 * 1.22)))}px`);
    function toggleTtx(force?: boolean) {
      const open = force ?? !root!.classList.contains('is-ttx');
      if (!open) { if (clearOverlays()) restore(); return; }
      const show = () => {
        closeContact();
        clearOverlays();
        root!.classList.add('is-ttx');
        ttx.hidden = false;
        txtBtns.forEach((b) => b.setAttribute('aria-pressed', 'true'));
        attract?.kill();
        gsap.set(bar, { scaleX: 0 });
        fitTtx();
        page(TXT_HOME);
        ttxClock = window.setInterval(() => ttxHeader(), 1000);
        burst(200, 0.6);
        sound.tick();
      };
      if (!on) powerOn(show); else show();
    }
    txtBtns.forEach((b) => b.addEventListener('click', () => toggleTtx()));
    addEventListener('resize', () => { if (root!.classList.contains('is-ttx')) fitTtx(); }, { signal });

    // ---- power ----
    function powerOff() {
      if (!on || powering) return;
      closeContact();
      clearOverlays();
      lock(null);
      attract?.kill();
      gsap.set(bar, { scaleX: 0 });
      sound.glitch();
      const done = () => {
        on = false;
        shown = -1;
        root!.classList.add('is-off');
        paintStandby();
      };
      if (reduce) { done(); return; }
      powering = true;
      // the picture squeezes to a line, the line to a dot, and the dot fades
      gsap.timeline({ onComplete: () => { powering = false; } })
        .fromTo(pic, { clipPath: 'inset(0% 0% 0% 0%)' }, { clipPath: 'inset(49.6% 0% 49.6% 0%)', duration: 0.22, ease: 'power3.in' })
        .set(line, { scaleX: 1, opacity: 1 })
        .add(done)
        .set(pic, { clearProps: 'clipPath' })
        .to(line, { scaleX: 0.004, duration: 0.2, ease: 'power3.in' })
        .set(ember, { opacity: 1 })
        .to(line, { opacity: 0, duration: 0.25, ease: 'power2.out' })
        .to(ember, { opacity: 0, duration: 1.8, ease: 'power2.out' }, '<');
    }
    powerBtns.forEach((b) => b.addEventListener('click', () => (on ? powerOff() : powerOn(0))));
    // the screensaver switches the set off too
    addEventListener('nyhz:power', (e) => { if ((e as CustomEvent<{ on: boolean }>).detail?.on === false) powerOff(); }, { signal });

    paintStandby();

    // leaving the page: whatever's still scheduled or looping stops with it
    signal.addEventListener('abort', () => {
      attract?.kill();
      [staticRaf, specialRaf].forEach(cancelAnimationFrame);
      [decodeIv, ttxClock].forEach(clearInterval);
      [adT, digitT, volT, fitT, newsRz].forEach(clearTimeout);
    });
  });
</script>
