---
---
<div data-nosnippet class="frame" aria-hidden="true" transition:persist="frame">
  <div class="frame__border">
    <span class="tick tl"></span><span class="tick tr"></span>
    <span class="tick bl"></span><span class="tick br"></span>
  </div>
  <span class="meta a act" data-activity hidden>
    <i class="act__dot"></i><span>last push</span><span class="act__k" data-act-when></span><b data-act-repo></b><span class="act__msg" data-act-msg></span>
  </span>
  <span class="meta d" data-clock-wrap>my time <b data-clock>--:--:--</b> <span data-clock-tz></span> · <span data-clock-doing></span><span class="note" data-clock-note></span> · © 2026</span>
</div>

<style>
  .frame { position: fixed; inset: 0; z-index: 2; pointer-events: none; }
  .frame__border { position: absolute; inset: clamp(14px, 1.6vw, 26px); border: 1px solid var(--line); }
  .tick { position: absolute; width: 9px; height: 9px; border: 1px solid var(--fg); }
  .tick.tl { left: -1px; top: -1px; border-right: 0; border-bottom: 0; }
  .tick.tr { right: -1px; top: -1px; border-left: 0; border-bottom: 0; }
  .tick.bl { left: -1px; bottom: -1px; border-right: 0; border-top: 0; }
  .tick.br { right: -1px; bottom: -1px; border-left: 0; border-top: 0; }

  /* pages that scroll (the lab's): the text passes under the corner lines */
  :global(html.is-doc) .meta { background: var(--bg); padding: 0.35rem 0.5rem; margin: -0.35rem -0.5rem; }
  .meta { position: absolute; font: 500 0.62rem var(--mono); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--muted); }
  .meta.a { left: clamp(26px, 2.6vw, 42px); top: clamp(22px, 2.4vw, 38px); color: var(--fg); }
  .meta.d { right: clamp(26px, 2.6vw, 42px); bottom: clamp(22px, 2.4vw, 38px);
    font-variant-numeric: tabular-nums; }
  @media (max-width: 520px) { .meta.d { display: none; } }

  /* last push (api/activity): the label in the meta style, the commit headline
     in plain case, typed out once it arrives */
  .act { display: flex; align-items: baseline; gap: 0.7rem; max-width: min(72ch, 52vw); color: var(--muted);
    white-space: nowrap; opacity: 0; transition: opacity 0.6s ease; }
  .act > * { flex: none; }
  .act[hidden] { display: none; }
  .act.is-in { opacity: 1; }
  .act__dot { align-self: center; flex: none; width: 5px; height: 5px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 6px var(--accent); }
  .act__k { color: var(--fg); }
  .act b { font-weight: 500; color: var(--fg); text-transform: none; letter-spacing: 0.04em; }
  .act__msg { flex: 0 1 auto !important; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    text-transform: none; letter-spacing: 0.02em; color: var(--dim); }
  @media (max-width: 720px) { .act { display: none; } }
  /* the screensaver's and snake's HUDs take this corner */
  :global(html.egg-sleep) .act, :global(html.egg-game) .act { opacity: 0; }
  /* special minutes (13:37, 03:33): the clock says something, in accent, and
     glitches as it starts */
  /* my clock (scripts/mytime.ts): the visitor has their own in the taskbar */
  .meta.d b { color: var(--fg); font-weight: 500; }
  .note { color: var(--accent); }
  .note:not(:empty)::before { content: ' · '; color: var(--muted); }
  .meta.d.is-glitch { animation: clockGlitch 0.9s steps(2) 1; }
  @keyframes clockGlitch {
    0%, 100% { text-shadow: none; transform: none; }
    20% { text-shadow: -2px 0 #ff2e63, 2px 0 #2ee6ff; transform: translateX(2px); }
    45% { text-shadow: 2px 0 #ff2e63, -2px 0 #2ee6ff; transform: translateX(-3px) skewX(-8deg); }
    70% { text-shadow: -1px 0 #ff2e63, 1px 0 #2ee6ff; transform: translateX(1px); }
  }
  @media (prefers-reduced-motion: reduce) { .meta.d.is-glitch { animation: none; } }
</style>

<script>
  import { clockNote } from '../scripts/eggs';
  import { relTime } from '../scripts/activity';
  import { activity } from '../scripts/feed';
  import { afterLoader } from '../scripts/loaded';
  import { timeIn, doing, hhmm, utc } from '../scripts/mytime';

  // last push: fetched once the loader is done (it never competes with the boot)
  const act = document.querySelector<HTMLElement>('[data-activity]');
  if (act) {
    afterLoader(async () => {
      const a = await activity(); // shared with the tv's ticker
      if (!a?.repo) return; // no data: stays hidden
      const when = act.querySelector('[data-act-when]');
      const msg = act.querySelector('[data-act-msg]');
      const at = Date.parse(a.at);
      const tickWhen = () => { if (when) when.textContent = relTime(Date.now() - at); };
      tickWhen();
      setInterval(tickWhen, 60000);
      act.querySelector('[data-act-repo]')!.textContent = a.repo;
      act.hidden = false;
      requestAnimationFrame(() => act.classList.add('is-in'));
      // the headline types itself out, like everything else here
      const text = a.message;
      if (!msg || !text) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { msg.textContent = text; return; }
      let i = 0;
      const iv = setInterval(() => { msg.textContent = text.slice(0, ++i); if (i >= text.length) clearInterval(iv); }, 18);
    });
  }

  const el = document.querySelector('[data-clock]');
  const wrap = document.querySelector<HTMLElement>('[data-clock-wrap]');
  const noteEl = document.querySelector('[data-clock-note]');
  const tzEl = document.querySelector('[data-clock-tz]');
  const doingEl = document.querySelector('[data-clock-doing]');
  let mine = '', mineAt = -1;
  if (el) {
    let lastNote = '';
    const tick = () => {
      const d = new Date();
      // my time, where I am, and what I'm probably up to: read once a minute,
      // the seconds tick
      // here (they're the same everywhere)
      const minute = Math.floor(d.getTime() / 60000);
      if (minute !== mineAt) {
        mineAt = minute;
        const t = timeIn(d);
        mine = hhmm(t);
        if (tzEl) tzEl.textContent = utc(t.offset);
        if (doingEl) doingEl.textContent = doing(t.h, t.day);
      }
      el.textContent = `${mine}:${String(d.getSeconds()).padStart(2, '0')}`;
      const note = clockNote(d.getHours(), d.getMinutes());
      if (note !== lastNote) {
        lastNote = note;
        if (noteEl) noteEl.textContent = note;
        if (note && wrap) {
          wrap.classList.remove('is-glitch');
          void wrap.offsetWidth;
          wrap.classList.add('is-glitch');
        }
        // the page goes l33t for the minute (Eggs.astro, which also checks
        // the time itself when it starts, in case it missed this)
        setTimeout(() => dispatchEvent(new CustomEvent('nyhz:leet', { detail: { on: !!note } })));
      }
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
