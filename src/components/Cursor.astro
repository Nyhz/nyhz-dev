---
// A custom cursor in the frame's own language: a teal dot inside the four
// corner ticks of the page frame. The ticks sit exactly on the pointer; over
// anything interactive they spring (back.out) to lock around the element's
// box. It glitches like the hero name — a jolt on lock, a harder one on
// click, and now and then on its own. Fine pointers only; text fields keep
// the native I-beam.
// Over code (a post's snippets) it becomes a caret, the way the tv switches
// off: the box squeezes sideways into a slit, flares, and settles into an
// I-beam with the dot at its heart. Left still it blinks like a terminal's;
// leaving, it switches back on into the box.
// It's on every page and outlives navigation (transition:persist): one cursor
// for the whole site, never swapped for the system's on the way to a post.
---
<div class="cur" data-cursor aria-hidden="true" transition:persist="cursor">
  <i class="cur__tick tl"></i><i class="cur__tick tr"></i>
  <i class="cur__tick bl"></i><i class="cur__tick br"></i>
  <i class="cur__beam"></i>
  <i class="cur__dot"></i>
</div>

<style>
  .cur { position: fixed; inset: 0; z-index: 200; pointer-events: none; opacity: 0;
    transition: opacity 0.2s ease; }
  .cur.is-on { opacity: 1; }
  .cur__tick, .cur__dot, .cur__beam { position: absolute; left: 0; top: 0; will-change: transform; }
  /* same 9px ticks as Frame.astro's corners (the script sizes them: they
     shrink to the caret's caps) */
  .cur__tick { width: 9px; height: 9px; border: 1px solid var(--fg); }
  .cur__tick.tl { border-right: 0; border-bottom: 0; }
  .cur__tick.tr { border-left: 0; border-bottom: 0; }
  .cur__tick.bl { border-right: 0; border-top: 0; }
  .cur__tick.br { border-left: 0; border-top: 0; }
  .cur__dot { width: 4px; height: 4px; margin: -2px 0 0 -2px; background: var(--accent);
    transition: opacity 0.2s ease, width 0.2s ease, height 0.2s ease, margin 0.2s ease; }
  .cur.is-locked .cur__dot { opacity: 0.5; }
  /* the hero name's chromatic split */
  .cur.is-glitch .cur__tick { filter: drop-shadow(-2px 0 rgba(255, 46, 99, 0.9)) drop-shadow(2px 0 rgba(46, 230, 255, 0.9)); }
  .cur.is-text { opacity: 0; }

  /* ---- the caret (over code) ---- */
  /* the line: its height and opacity come from the script (the morph) */
  .cur__beam { width: 1px; height: 0; opacity: 0; background: rgba(241, 239, 233, 0.92);
    transition: background-color 0.15s ease, box-shadow 0.15s ease; }
  .cur.is-beam .cur__dot { width: 3px; height: 3px; margin: -1px 0 0 -1px; }
  /* mid-morph the dot steps out, and drops back in once the caret settles */
  .cur.is-morph .cur__dot { opacity: 0; }
  /* the flare as the slit closes (and opens): white-hot, split red and cyan */
  .cur.is-flash .cur__beam { background: #fff;
    box-shadow: -2px 0 rgba(255, 46, 99, 0.9), 2px 0 rgba(46, 230, 255, 0.9), 0 0 14px rgba(58, 210, 159, 0.9); }
  .cur.is-flash .cur__tick { border-color: #fff; }
  /* dragging a selection: the line burns teal */
  .cur.is-beam.is-down .cur__beam { background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  /* left still: it blinks, like a terminal's caret */
  .cur.is-beam.is-idle:not(.is-down) .cur__beam { animation: curBlink 1.06s steps(1) infinite; }
  @keyframes curBlink { 50% { opacity: 0.1; } }
  .cur.is-glitch .cur__beam { box-shadow: -2px 0 rgba(255, 46, 99, 0.9), 2px 0 rgba(46, 230, 255, 0.9); }

  :global(html.has-cursor), :global(html.has-cursor *) { cursor: none !important; }
  :global(html.has-cursor input), :global(html.has-cursor textarea) { cursor: text !important; }
</style>

<script>
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-cursor]');
  const fine = matchMedia('(hover: hover) and (pointer: fine)');

  if (root && fine.matches) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const [tl, tr, bl, br] = (['tl', 'tr', 'bl', 'br'] as const).map((c) => root.querySelector<HTMLElement>(`.${c}`)!);
    const ticks = [tl, tr, bl, br];
    const dot = root.querySelector<HTMLElement>('.cur__dot')!;
    const line = root.querySelector<HTMLElement>('.cur__beam')!;
    const TICK = 9, REST = 22, PAD = 6;
    const CODE = '.post__body pre';
    const INTERACTIVE = 'a[href], button:not(:disabled), [role="button"], summary';
    const TEXT = 'input:not([type="checkbox"]):not([type="radio"]), textarea, [contenteditable="true"]';

    document.documentElement.classList.add('has-cursor');
    // a navigation brings the new page's <html> attributes: say it again
    document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('has-cursor'));

    // The free cursor's shape — the box (w × h, ticks tw × th) and the caret's
    // line (lh tall, lo opaque) — which the morph tweens between the two:
    const BOX = { w: REST, h: REST, tw: TICK, th: TICK, lh: 0, lo: 0 };
    const CARET = { w: 9, h: 20, tw: 4, th: 1, lh: 20, lo: 1 }; // 4px caps either side of a 1px line
    const shape = { ...BOX };

    const ptr = { x: innerWidth / 2, y: innerHeight / 2 };
    const box = { x: ptr.x - REST / 2, y: ptr.y - REST / 2, w: REST, h: REST };
    const press = { v: 0 };
    let target: HTMLElement | null = null;
    let locking = false;   // a lock tween is running: don't snap to the rect yet
    let releaseUntil = 0;  // just unlocked: ease back down to the pointer
    let caret = false;
    let morph: gsap.core.Timeline | null = null;
    let raf = 0;

    // glitch: for a few frames each tick jumps by a random offset (re-rolled
    // every ~45ms, steps-like) with the chromatic split on
    const jit = [0, 1, 2, 3].map(() => ({ x: 0, y: 0 }));
    let glitchEnd = 0, glitchAmp = 0, nextRoll = 0;
    function glitch(amp: number, ms: number) {
      if (reduce) return;
      const now = performance.now();
      glitchAmp = now < glitchEnd ? Math.max(amp, glitchAmp) : amp;
      glitchEnd = Math.max(glitchEnd, now + ms);
      nextRoll = 0;
      root!.classList.add('is-glitch');
    }

    const lockRect = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      return { x: r.left - PAD, y: r.top - PAD, w: r.width + PAD * 2, h: r.height + PAD * 2 };
    };

    function lock(el: HTMLElement | null) {
      if (el === target) return;
      target = el;
      root!.classList.toggle('is-locked', !!el);
      gsap.killTweensOf(box);
      if (!el) { locking = false; releaseUntil = performance.now() + 260; return; } // back onto the pointer
      locking = true;
      glitch(3, 160);
      gsap.to(box, { ...lockRect(el), duration: reduce ? 0 : 0.5, ease: 'back.out(1.7)',
        onComplete: () => { locking = false; } });
    }

    // the flare where the slit closes or opens
    let flashT = 0;
    const flash = () => {
      root!.classList.add('is-flash');
      glitch(3, 180);
      clearTimeout(flashT);
      flashT = window.setTimeout(() => root!.classList.remove('is-flash'), 170);
    };

    function setCaret(on: boolean) {
      if (on === caret) return;
      caret = on;
      morph?.kill();
      root!.classList.toggle('is-beam', on);
      root!.classList.remove('is-idle');
      if (reduce) { Object.assign(shape, on ? CARET : BOX); return; }
      root!.classList.add('is-morph');
      const done = () => root!.classList.remove('is-morph');
      morph = on
        ? gsap.timeline({ onComplete: done })
          // switching off: the box squeezes sideways into a slit, taller than the caret will be…
          .to(shape, { w: 1, tw: 1, th: 1, h: 40, duration: 0.17, ease: 'power3.in' })
          .to(shape, { lh: 40, lo: 1, duration: 0.06, ease: 'none' }, 0.12)
          .call(flash)
          // …then drops to a line's height, and the caps grow out of it
          .to(shape, { h: CARET.h, lh: CARET.lh, duration: 0.6, ease: 'elastic.out(1, 0.4)' })
          .to(shape, { w: CARET.w, tw: CARET.tw, duration: 0.32, ease: 'back.out(3)' }, '<0.06')
        : gsap.timeline({ onComplete: done })
          // switching on: the caps fold in, the line flares and gives way to the box, springing out
          .to(shape, { w: 1, tw: 1, h: 30, lh: 30, duration: 0.12, ease: 'power2.in' })
          .call(flash)
          .to(shape, { lh: 0, lo: 0, duration: 0.14, ease: 'power2.in' })
          .to(shape, { w: BOX.w, h: BOX.h, tw: BOX.tw, th: BOX.th, duration: 0.5, ease: 'back.out(2.2)' }, '<');
    }

    function frame() {
      const now = performance.now();
      if (target && !target.isConnected) lock(null);
      if (target && !locking) Object.assign(box, lockRect(target));       // stay on it if it moves
      else if (!target) {
        // centred on the pointer, no lag — except a short ease back down from
        // a lock, so leaving an element doesn't snap
        const k = reduce || now >= releaseUntil ? 1 : 0.35;
        box.x += (ptr.x - shape.w / 2 - box.x) * k; box.y += (ptr.y - shape.h / 2 - box.y) * k;
        box.w += (shape.w - box.w) * k; box.h += (shape.h - box.h) * k;
      }
      if (now < glitchEnd) {
        if (now >= nextRoll) {
          jit.forEach((j) => { j.x = (Math.random() - 0.5) * 2 * glitchAmp; j.y = (Math.random() - 0.5) * glitchAmp; });
          nextRoll = now + 45;
        }
      } else if (glitchAmp) {
        glitchAmp = 0;
        jit.forEach((j) => { j.x = 0; j.y = 0; });
        root!.classList.remove('is-glitch');
      }
      const p = press.v;
      const tw = target ? TICK : shape.tw, th = target ? TICK : shape.th;
      const x0 = box.x + p, y0 = box.y + p, x1 = box.x + box.w - tw - p, y1 = box.y + box.h - th - p;
      // the caret's hairlines sit on whole pixels, or they blur
      const at = caret || morph?.isActive() ? Math.round : (n: number) => n;
      ticks.forEach((el, i) => {
        const [x, y] = [[x0, y0], [x1, y0], [x0, y1], [x1, y1]][i];
        el.style.width = `${tw}px`; el.style.height = `${th}px`;
        el.style.transform = `translate(${at(x + jit[i].x)}px, ${at(y + jit[i].y)}px)`;
      });
      dot.style.transform = `translate(${at(ptr.x)}px, ${at(ptr.y)}px)`;
      if (shape.lo > 0) {
        line.style.height = `${shape.lh}px`;
        line.style.opacity = String(shape.lo);
        line.style.transform = `translate(${at(ptr.x)}px, ${at(ptr.y - shape.lh / 2)}px)`;
      } else line.style.opacity = '0';
      raf = requestAnimationFrame(frame);
    }

    // still over code for a moment: the caret starts blinking
    let idleT = 0;
    addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') { root.classList.remove('is-on'); return; }
      ptr.x = e.clientX; ptr.y = e.clientY;
      root.classList.add('is-on');
      root.classList.remove('is-idle');
      clearTimeout(idleT);
      idleT = window.setTimeout(() => { if (caret) root.classList.add('is-idle'); }, 650);
      if (!raf) raf = requestAnimationFrame(frame);
    }, { passive: true });

    addEventListener('pointerover', (e) => {
      const el = e.target as Element;
      root.classList.toggle('is-text', !!el.closest(TEXT));
      const hit = el.closest<HTMLElement>(INTERACTIVE);
      lock(hit);
      setCaret(!hit && !!el.closest(CODE));
    }, { passive: true });

    // a press squeezes the ticks in, release springs them back (the caret
    // doesn't squeeze: its line burns teal while a selection is dragged)
    addEventListener('pointerdown', () => {
      root.classList.add('is-down');
      if (reduce || caret) return;
      gsap.to(press, { v: 3, duration: 0.12, ease: 'power2.out' });
      glitch(5, 220);
    });
    addEventListener('pointerup', () => {
      root.classList.remove('is-down');
      if (!reduce) gsap.to(press, { v: 0, duration: 0.45, ease: 'back.out(2.4)' });
    });

    document.documentElement.addEventListener('pointerleave', () => root.classList.remove('is-on'));

    // and every so often, on its own (same irregular rhythm as the hero name)
    if (!reduce) {
      const idle = () => {
        if (root.classList.contains('is-on') && !document.hidden) glitch(2, 140);
        setTimeout(idle, 4000 + Math.random() * 5000);
      };
      setTimeout(idle, 4000 + Math.random() * 5000);
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { cancelAnimationFrame(raf); raf = 0; }
    });
  }
</script>
