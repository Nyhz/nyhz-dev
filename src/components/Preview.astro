---
import Contact from './Contact.astro';
---
<div class="preview" data-anim>
  <div class="pv__head">
    <button class="pv__back" data-back type="button"><span aria-hidden="true">←</span> back</button>
    <p class="sec-label sec-label--r" data-pv-label>— preview</p>
  </div>

  <div class="pv__frame" data-frame>
    <p class="pv__idle" aria-hidden="true">› select a project<i class="pv__caret"></i></p>

    <!-- a project, as `cat slug.md`: frontmatter, a heading, the description,
         and the links as commands. The cover rides along only where there's
         no cursor to carry it (phones, tablets) — elsewhere it follows the
         pointer over the list (Peek.astro). -->
    <div class="pv__card" data-card>
      <div class="pv__dossier pv__dossier--md">
        <a class="pv__shot" data-shot tabindex="-1" aria-hidden="true" target="_blank" rel="noopener noreferrer">
          <img alt="" data-shot-img decoding="async" />
        </a>
        <p class="pv__cmd" data-cmd-host><span class="pv__p" aria-hidden="true">›</span> <span data-cmd></span><i class="pv__caret" aria-hidden="true"></i></p>
        <div class="pv__fm" data-fm>
          <p class="pv__rule" aria-hidden="true">---</p>
          <dl>
            <div><dt>status</dt><dd><span class="pv__st" data-f-status></span></dd></div>
            <div><dt>stack</dt><dd data-f-stack></dd></div>
            <div data-f-year-row><dt>year</dt><dd data-f-year></dd></div>
            <div data-f-role-row><dt>role</dt><dd data-f-role></dd></div>
          </dl>
          <p class="pv__rule" aria-hidden="true">---</p>
        </div>
        <h3 class="pv__d-title pv__h"><span data-title-t></span><i class="pv__caret" aria-hidden="true"></i></h3>
        <p class="pv__d-desc"><span data-desc-t></span><i class="pv__caret" aria-hidden="true"></i></p>
        <nav class="pv__cmds" data-foot aria-label="project links">
          <a class="pv__btn pv__btn--go" data-live target="_blank" rel="noopener noreferrer" hidden><span aria-hidden="true">↗</span> open live</a>
          <a class="pv__btn pv__btn--go" data-download target="_blank" rel="noopener noreferrer" hidden><span aria-hidden="true">↓</span> download</a>
          <a class="pv__btn" data-repo target="_blank" rel="noopener noreferrer" hidden><span aria-hidden="true">↗</span> source</a>
        </nav>
      </div>
    </div>

    <!-- "available for work" opens here, as one more dossier -->
    <div class="pv__card" id="contact" data-contact-card role="region" aria-label="contact" hidden>
      <div class="pv__dossier pv__dossier--contact">
        <p class="pv__d-title" data-ct-title-host><span data-ct-title></span><i class="pv__caret" aria-hidden="true"></i></p>
        <p class="pv__d-desc pv__d-desc--short" data-ct-desc-host><span data-ct-desc></span><i class="pv__caret" aria-hidden="true"></i></p>
        <Contact />
      </div>
    </div>
  </div>
</div>

<style>
  .preview { position: relative; width: 100%; }

  .pv__frame { position: relative; width: 100%; }
  .pv__idle { position: absolute; top: 1.1rem; left: 1.2rem; font: 0.8rem var(--mono); color: var(--muted);
    transition: opacity 0.3s ease; }
  .pv__idle .pv__caret { display: inline-block; animation: pvBlink 0.8s steps(1) infinite; }
  .preview.pv-active .pv__idle { opacity: 0; }
  .pv__head { display: flex; align-items: baseline; justify-content: flex-end; }
  .preview .sec-label { opacity: 0; transition: opacity 0.35s ease; }
  .preview.pv-active .sec-label { opacity: 1; }
  .pv__back { display: none; background: none; border: none; cursor: pointer; padding: 0;
    font: 500 0.66rem var(--mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
    transition: color 0.2s; }
  .pv__back:hover { color: var(--fg); }
  .pv__back:active { transform: translateX(-2px); }

  /* hidden cards are also out of the way of taps (GSAP autoAlpha) */
  .pv__card { opacity: 0; visibility: hidden; will-change: transform, opacity; }

  /* the dossier box (shared with contact): a faint scanline keeps it on-brand */
  .pv__dossier { position: relative; overflow: hidden; border: 1px solid var(--line); padding: 1rem 1.2rem 1.1rem; }
  .pv__dossier::after { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0.4;
    background: repeating-linear-gradient(0deg, rgba(180,180,180,0.05) 0 1px, transparent 1px 3px); }
  .pv__d-title { font: 700 1.05rem var(--mono); letter-spacing: -0.01em; color: var(--fg);
    margin: 0 0 0.7rem; min-height: 1.3em; }
  .pv__d-desc { font: 0.8rem/1.7 var(--mono); color: var(--dim); margin: 0; }
  .pv__dossier--contact { padding-bottom: 0.9rem; }
  .pv__dossier--contact .pv__d-desc { margin-bottom: 0.9rem; }
  .pv__d-desc--short { min-height: 1.7em; }
  .pv__caret { display: none; width: 0.5em; height: 1.05em; background: var(--accent);
    vertical-align: -0.16em; margin-left: 2px; }
  .typing > .pv__caret { display: inline-block; animation: pvBlink 0.8s steps(1) infinite; }
  @keyframes pvBlink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  /* ---- the project as markdown ---- */
  .pv__cmd { font: 0.72rem var(--mono); color: var(--muted); min-height: 1.5em; margin-bottom: 0.35rem; }
  .pv__p { color: var(--accent); }
  .pv__fm { font: 0.76rem/1.7 var(--mono); }
  .pv__rule { color: var(--muted); opacity: 0.55; letter-spacing: 0.1em; }
  .pv__fm dl > div { display: grid; grid-template-columns: 7ch minmax(0, 1fr); gap: 0 0.8ch; }
  .pv__fm dl > div[hidden] { display: none; }
  .pv__fm dt { color: var(--muted); }
  .pv__fm dt::after { content: ':'; }
  .pv__fm dd { margin: 0; color: var(--fg); min-width: 0; }
  .pv__st::before { content: '● '; }
  .pv__st[data-s="live"] { color: var(--accent); }
  .pv__st[data-s="download"] { color: var(--fg); }
  .pv__st[data-s="personal"] { color: var(--dim); }
  .pv__h { margin: 0.85rem 0 0.4rem; font-size: 1.2rem; }
  .pv__h::before { content: '# '; color: var(--muted); font-weight: 500; }
  .pv__fm > *, .pv__cmds { opacity: 0; }

  /* links as commands */
  .pv__cmds { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .pv__btn { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.45rem 0.8rem;
    border: 1px solid var(--line); font: 500 0.66rem var(--mono); letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--fg); transition: color var(--t-hover) ease, border-color var(--t-hover) ease, box-shadow var(--t-hover) ease; }
  .pv__btn[hidden] { display: none; }
  .pv__btn--go { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .pv__btn:hover, .pv__btn:focus-visible { color: var(--accent); border-color: var(--accent); outline: none;
    box-shadow: 0 0 18px -6px var(--accent); }
  .pv__btn:active { transform: translateY(1px); transition-duration: var(--t-press); }

  /* the cover inside the card: only where there's no cursor to carry it.
     16:10, monochrome until it "develops" into colour once loaded. */
  .pv__shot { display: none; position: relative; aspect-ratio: 16 / 10; max-height: 28vh; width: calc(100% + 2.4rem);
    margin: -1rem -1.2rem 0.85rem; border-bottom: 1px solid var(--line); overflow: hidden; background: #0e0e0d; }
  .pv__shot img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%;
    filter: grayscale(1) contrast(1.15) brightness(0.9); transition: filter 1.4s var(--ease-out) 0.15s; }
  .pv__shot.is-dev img { filter: none; }
  .pv__shot::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.18) 0 1px, transparent 1px 3px); }
  .pv__shot.is-empty { display: none !important; }
  @media (hover: none), (max-width: 720px) { .pv__shot { display: block; } }

  @media (max-width: 720px) {
    .pv__head { justify-content: space-between; }
    .pv__idle { display: none !important; }
    /* the contact dossier has to fit under the hero in one phone screen */
    .pv__dossier--contact { padding: 0.9rem 1rem 0.6rem; }
    .pv__dossier--contact .pv__d-desc--short { display: none; }
    .pv__back { display: inline-flex; gap: 0.4rem; }
    .pv__dossier--md { padding: 0.9rem 1rem 1rem; }
    .pv__shot { width: calc(100% + 2rem); margin: -0.9rem -1rem 0.8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pv__btn, .pv__shot img { transition: none; }
    .typing > .pv__caret, .pv__idle .pv__caret { animation: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const pv = document.querySelector('.preview');
  const card = pv?.querySelector('[data-card]') as HTMLElement | null;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => (pv?.querySelector<T>(s) ?? null);
  const titleEl = card?.querySelector<HTMLElement>('.pv__h') ?? null;
  const descEl = card?.querySelector<HTMLElement>('.pv__d-desc') ?? null;
  const titleT = card?.querySelector<HTMLElement>('[data-title-t]') ?? null;
  const descT = card?.querySelector<HTMLElement>('[data-desc-t]') ?? null;
  const cmdHost = $('[data-cmd-host]');
  const cmdT = $('[data-cmd]');
  const fmEl = $('[data-fm]');
  const fmLines = Array.from(fmEl?.children ?? []) as HTMLElement[];
  const footEl = $('[data-foot]');
  const shot = $<HTMLAnchorElement>('[data-shot]');
  const shotImg = $<HTMLImageElement>('[data-shot-img]');
  const track = document.querySelector('[data-track]') as HTMLElement | null;
  const label = $('[data-pv-label]');
  const ctCard = $('[data-contact-card]');
  const ctTitleHost = $('[data-ct-title-host]');
  const ctTitle = $('[data-ct-title]');
  const ctDescHost = $('[data-ct-desc-host]');
  const ctDesc = $('[data-ct-desc]');
  const ctFields = Array.from(ctCard?.querySelectorAll<HTMLElement>('[data-field]') ?? []);
  const avail = document.querySelector<HTMLButtonElement>('[data-contact-open]');
  const CT_TITLE = 'write to me';
  const CT_DESC = "tell me what you're building.";
  const back = document.querySelector('[data-back]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.prj[data-proj]'));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = () => matchMedia('(max-width: 720px)').matches;
  // phones focus on the open card: the hero folds away to make room (Projects.astro)
  const focus = (on: boolean) => { if (isMobile()) dispatchEvent(new CustomEvent('nyhz:focus', { detail: { on } })); };

  // fill the card with a project (no animation; the timeline reveals it)
  function fill(c: HTMLElement, d: DOMStringMap) {
    const set = (sel: string, v = '') => { const el = c.querySelector(sel); if (el) el.textContent = v; };
    set('[data-f-status]', d.status);
    c.querySelector<HTMLElement>('[data-f-status]')?.setAttribute('data-s', d.status || '');
    set('[data-f-stack]', d.tags);
    set('[data-f-year]', d.year);
    set('[data-f-role]', d.role);
    const yr = c.querySelector<HTMLElement>('[data-f-year-row]');
    const rr = c.querySelector<HTMLElement>('[data-f-role-row]');
    if (yr) yr.hidden = !d.year;
    if (rr) rr.hidden = !d.role;
    const links: [string, string | undefined][] = [['[data-live]', d.live], ['[data-download]', d.download], ['[data-repo]', d.repo]];
    links.forEach(([sel, href]) => {
      const a = c.querySelector<HTMLAnchorElement>(sel);
      if (!a) return;
      if (href) { a.href = href; a.hidden = false; } else a.hidden = true;
    });
  }
  const fileOf = (slug: string) => `cat ${slug}.md`;

  // the cover inside the card (no-cursor devices): load, then develop to colour
  function setShot(d: DOMStringMap) {
    if (!shot || !shotImg) return;
    shot.classList.remove('is-dev');
    shot.classList.toggle('is-empty', !d.cover);
    shot.href = d.live || d.download || d.repo || '';
    if (!d.cover) { shotImg.removeAttribute('src'); return; }
    shotImg.onload = () => setTimeout(() => shot.classList.add('is-dev'), reduce ? 0 : 250);
    shotImg.src = d.cover;
  }

  // ---- zero layout shift (desktop) ----
  // The panel reserves the height of its tallest possible state — the contact
  // dossier or any project's dossier — measured on invisible clones, so
  // switching between them (or from idle) can never move the page.
  const frame = $('[data-frame]');
  function reserve() {
    if (!frame || !card || !ctCard) return;
    const probe = (src: HTMLElement, prep?: (c: HTMLElement) => void) => {
      const c = src.cloneNode(true) as HTMLElement;
      c.removeAttribute('id');
      c.hidden = false;
      c.inert = true;
      c.querySelectorAll('[name]').forEach((el) => el.removeAttribute('name'));
      Object.assign(c.style, { position: 'absolute', top: '0', left: '0', right: '0',
        visibility: 'hidden', opacity: '0', transform: 'none' });
      prep?.(c);
      frame.append(c);
      const h = c.offsetHeight;
      c.remove();
      return h;
    };
    const heights = [probe(ctCard), ...rows.map((r) => probe(card, (c) => {
      const d = r.dataset;
      fill(c, d);
      const set = (sel: string, v = '') => { const el = c.querySelector(sel); if (el) el.textContent = v; };
      set('[data-cmd]', fileOf(d.proj || ''));
      set('[data-title-t]', d.title);
      set('[data-desc-t]', d.desc);
      c.querySelector('[data-shot]')?.classList.toggle('is-empty', !d.cover);
    }))];
    frame.style.minHeight = `${Math.max(...heights)}px`;
  }
  document.fonts.ready.then(reserve);
  let reserveT = 0;
  addEventListener('resize', () => { clearTimeout(reserveT); reserveT = window.setTimeout(reserve, 120); });

  function reset() {
    [titleT, descT, cmdT].forEach((el) => { if (el) el.textContent = ''; });
    [titleEl, descEl, cmdHost].forEach((el) => el?.classList.remove('typing'));
    gsap.set([...fmLines, footEl].filter(Boolean), { opacity: 0, x: 0 });
  }

  // `current` is a project slug, 'contact', or null; `shown` is the card on screen
  let current: string | null = null;
  let shown: HTMLElement | null = null;
  let tl: gsap.core.Timeline | null = null;

  function setMode(m: 'project' | 'contact') {
    if (card) card.hidden = m !== 'project';
    if (ctCard) ctCard.hidden = m !== 'contact';
    pv?.classList.toggle('pv-contact', m === 'contact');
    if (label) label.textContent = m === 'contact' ? '— contact' : '— preview';
    avail?.setAttribute('aria-expanded', String(m === 'contact'));
  }

  const CARD_IN = 0.6;
  function enterIn(t: gsap.core.Timeline, el: HTMLElement) {
    t.fromTo(el, { autoAlpha: 0, x: -40 },
      { autoAlpha: 1, x: 0, duration: CARD_IN, ease: 'back.out(2.4)', immediateRender: false });
  }
  function leaveOut(t: gsap.core.Timeline, el: HTMLElement, after?: () => void) {
    t.to(el, { x: 26, duration: 0.18, ease: 'power2.out' });
    t.to(el, { x: -170, autoAlpha: 0, duration: 0.38, ease: 'power3.in', onComplete: after }, '>');
  }

  function typeInto(t: gsap.core.Timeline, host: HTMLElement, span: HTMLElement, text: string, per: number) {
    const s = { i: 0 };
    t.add(() => { host.classList.add('typing'); span.textContent = ''; });
    t.to(s, { i: text.length, duration: Math.max(0.15, text.length * per),
      ease: `steps(${Math.max(1, text.length)})`,
      onUpdate() { span.textContent = text.slice(0, Math.round(s.i)); } });
  }

  // like a terminal: the command types, its output (the frontmatter) prints
  // line by line, then the heading and the description type out, and the
  // links come up last
  function typeDossier(t: gsap.core.Timeline, d: DOMStringMap) {
    if (!titleEl || !descEl || !titleT || !descT || !cmdHost || !cmdT || !footEl) return;
    typeInto(t, cmdHost, cmdT, fileOf(d.proj || ''), 0.018);
    t.add(() => cmdHost.classList.remove('typing'));
    t.fromTo(fmLines, { opacity: 0, x: -6 }, { opacity: 1, x: 0, duration: 0.18, stagger: 0.06, ease: 'power2.out' }, '>+0.05');
    typeInto(t, titleEl, titleT, d.title || '', 0.03);
    t.add(() => titleEl.classList.remove('typing'));
    typeInto(t, descEl, descT, d.desc || '', 0.009);   // keeps the caret at the end
    t.fromTo(footEl, { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out' }, '>-0.1');
  }

  function show(slug: string, d: DOMStringMap) {
    if (!card || slug === current) return;
    const old = shown;
    current = slug;
    shown = card;
    pv?.classList.add('pv-active');
    tl?.kill();
    const prep = () => { setMode('project'); reset(); fill(card, d); setShot(d); };

    if (reduce || isMobile()) {
      prep();
      if (cmdT) cmdT.textContent = fileOf(slug);
      if (titleT) titleT.textContent = d.title || '';
      if (descT) descT.textContent = d.desc || '';
      gsap.set(card, { autoAlpha: 1, x: 0 });
      gsap.set([...fmLines, footEl].filter(Boolean), { opacity: 1, x: 0, y: 0 });
      return;
    }

    tl = gsap.timeline();
    if (old) leaveOut(tl, old, prep); // content swaps only AFTER the old card has left
    else { prep(); gsap.set(card, { autoAlpha: 0, x: -40 }); }
    enterIn(tl, card);
    typeDossier(tl, d);
  }

  function resetContact() {
    if (ctTitle) ctTitle.textContent = '';
    if (ctDesc) ctDesc.textContent = '';
    ctTitleHost?.classList.remove('typing');
    ctDescHost?.classList.remove('typing');
    gsap.set(ctFields, { opacity: 0, y: 8 });
  }
  const focusForm = () => {
    ctDescHost?.classList.remove('typing'); // the caret hands over to the input
    ctCard?.querySelector<HTMLElement>('input')?.focus({ preventScroll: true });
  };

  function showContact() {
    if (!ctCard || current === 'contact') return;
    const old = shown;
    current = 'contact';
    shown = ctCard;
    pv?.classList.add('pv-active');
    tl?.kill();
    const prep = () => { setMode('contact'); resetContact(); };

    if (reduce || isMobile()) {
      prep();
      if (ctTitle) ctTitle.textContent = CT_TITLE;
      if (ctDesc) ctDesc.textContent = CT_DESC;
      gsap.set(ctCard, { autoAlpha: 1, x: 0 });
      gsap.set(ctFields, { opacity: 1, y: 0 });
      if (!isMobile()) focusForm();
      return;
    }

    tl = gsap.timeline();
    if (old) leaveOut(tl, old, prep);
    else { prep(); gsap.set(ctCard, { autoAlpha: 0, x: -40 }); }
    const enterAt = tl.duration();
    enterIn(tl, ctCard);
    if (ctTitleHost && ctTitle && ctDescHost && ctDesc) {
      typeInto(tl, ctTitleHost, ctTitle, CT_TITLE, 0.03);
      tl.add(() => ctTitleHost.classList.remove('typing'));
      typeInto(tl, ctDescHost, ctDesc, CT_DESC, 0.012);
    }
    // fields don't wait for the typing — the form is usable while it finishes
    const at = enterAt + 0.4;
    tl.to(ctFields, { opacity: 1, y: 0, stagger: 0.05, duration: 0.3, ease: 'power2.out' }, at);
    tl.add(() => ctCard.querySelector<HTMLElement>('input')?.focus({ preventScroll: true }), at);
    tl.add(() => ctDescHost?.classList.remove('typing'));
  }

  function hide() {
    if (current === null || !shown) return;
    const old = shown;
    current = null;
    shown = null;
    avail?.setAttribute('aria-expanded', 'false');
    tl?.kill();
    tl = gsap.timeline();
    // card away, and only then the idle prompt returns
    leaveOut(tl, old, () => pv?.classList.remove('pv-active'));
  }

  // phones: open the panel (slide) and give it the room
  const openPanel = () => { track?.classList.add('is-preview'); focus(true); };
  const closePanel = () => { track?.classList.remove('is-preview'); focus(false); };

  rows.forEach((r) => {
    const slug = r.dataset.proj!;
    r.querySelector('.prj__trigger')?.addEventListener('click', () => {
      if (isMobile()) { show(slug, r.dataset); openPanel(); return; }
      if (slug === current) hide(); else show(slug, r.dataset);
    });
  });
  back?.addEventListener('click', () => {
    closePanel();
    if (current === 'contact') hide();
  });

  // "available for work" (hero) toggles the contact dossier, like a project row
  avail?.addEventListener('click', () => {
    if (isMobile()) { showContact(); openPanel(); return; }
    if (current === 'contact') hide(); else showContact();
  });
  // Esc closes the contact dossier from anywhere (the terminal swallows its own Esc)
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || current !== 'contact') return;
    hide();
    closePanel();
    avail?.focus();
  });
  // the terminal's `contact`
  addEventListener('nyhz:contact', () => {
    showContact();
    if (isMobile()) openPanel();
  });
  // the terminal's `open <project>` — always shows (a row click toggles)
  addEventListener('nyhz:open', (e) => {
    const slug = (e as CustomEvent<{ slug: string }>).detail?.slug;
    const r = rows.find((row) => row.dataset.proj === slug);
    if (!slug || !r) return;
    show(slug, r.dataset);
    if (isMobile()) openPanel();
  });
</script>
