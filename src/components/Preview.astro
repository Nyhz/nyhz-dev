---
import Contact from './Contact.astro';
---
<div class="preview" data-anim>
  <div class="pv__head">
    <button class="pv__back" data-back type="button"><span aria-hidden="true">←</span> back</button>
    <p class="sec-label sec-label--r" data-pv-label>— preview</p>
  </div>

  <a class="pv__screen" data-screen tabindex="-1" aria-hidden="true" target="_blank" rel="noopener noreferrer">
    <canvas></canvas>
  </a>

  <div class="pv__frame" data-frame>
    <p class="pv__idle" aria-hidden="true">› select a project<i class="pv__caret"></i></p>
    <div class="pv__card" data-card>
      <div class="pv__dossier">
        <p class="pv__d-title"><span data-title-t></span><i class="pv__caret" aria-hidden="true"></i></p>
        <p class="pv__d-desc"><span data-desc-t></span><i class="pv__caret" aria-hidden="true"></i></p>
        <dl class="pv__meta" data-meta>
          <div class="pv__meta-row"><dt class="pv__k">stack</dt><dd class="pv__v" data-stack></dd></div>
        </dl>
      </div>
      <div class="pv__foot" data-foot>
        <nav class="pv__links">
          <a class="pv__link" data-repo target="_blank" rel="noopener noreferrer" hidden>github <span class="ar" aria-hidden="true">↗</span></a>
          <a class="pv__link" data-live target="_blank" rel="noopener noreferrer" hidden>live <span class="ar" aria-hidden="true">↗</span></a>
          <a class="pv__link" data-download target="_blank" rel="noopener noreferrer" hidden>download <span class="ar" aria-hidden="true">↓</span></a>
        </nav>
      </div>
    </div>

    <!-- "available for work" opens here, as one more dossier -->
    <div class="pv__card" id="contact" data-contact-card role="region" aria-label="contact" hidden>
      <div class="pv__dossier pv__dossier--contact">
        <p class="pv__d-title" data-ct-title-host><span data-ct-title></span><i class="pv__caret" aria-hidden="true"></i></p>
        <p class="pv__d-desc pv__d-desc--short" data-ct-desc-host><span data-ct-desc></span><i class="pv__caret" aria-hidden="true"></i></p>
        <Contact />
      </div>
    </div>
  </div>
</div>

<style>
  .preview { position: relative; width: 100%; }

  /* the cover "screen" lives in dead space (absolutely placed → never moves the
     layout): above this column, between it and the hero — or, with the list
     expanded and the hero collapsed, below the dossier (.is-below). Its size
     and spot are measured in JS; it stays hidden when there is too little room. */
  /* it enters and leaves with the dossier card's own move, turned vertical
     (preview timeline) — hidden until then */
  .pv__screen { position: absolute; left: 0; right: 0; bottom: calc(100% + 1.1rem); display: none;
    border: 1px solid var(--line); overflow: hidden; background: #0e0e0d; opacity: 0;
    transition: border-color var(--t-hover) ease; }
  .pv__screen.is-on { display: block; }
  .pv__screen canvas { display: block; width: 100%; height: 100%;
    filter: grayscale(1) contrast(1.2) brightness(1.15); transition: filter 0.5s var(--ease-out); }
  /* light interfaces are shown inverted so they sit in the dark page like the
     rest; hover still reveals the real colours */
  .pv__screen.is-light canvas { filter: grayscale(1) invert(1) contrast(1.15) brightness(1.05); }
  .pv__screen::after { content: ""; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(0,0,0,0.22) 0 1px, transparent 1px 3px); }
  @media (hover: hover) {
    .pv__screen:hover { border-color: var(--muted); }
    .pv__screen:hover canvas { filter: none; }
  }

  .pv__frame { position: relative; }
  .pv__idle { position: absolute; top: 1.1rem; left: 1.2rem; font: 0.8rem var(--mono); color: var(--muted);
    transition: opacity 0.3s ease; }
  .pv__idle .pv__caret { display: inline-block; animation: pvBlink 0.8s steps(1) infinite; }
  .preview.pv-active .pv__idle { opacity: 0; }
  .pv__head { display: flex; align-items: baseline; justify-content: flex-end; }
  .preview .sec-label { opacity: 0; transition: opacity 0.35s ease; }
  .preview.pv-active .sec-label { opacity: 1; }
  .pv__back { display: none; background: none; border: none; cursor: pointer; padding: 0;
    font: 500 0.66rem var(--mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
    transition: color 0.2s; }
  .pv__back:hover { color: var(--fg); }
  .pv__back:active { transform: translateX(-2px); }

  .pv__frame { width: 100%; }
  .pv__card { opacity: 0; will-change: transform, opacity; }

  /* terminal dossier — title + description type out (teal caret), then the meta
     block fades in. A single faint scanline keeps it on-brand, not loud. */
  .pv__dossier { position: relative; min-height: 12rem; overflow: hidden;
    border: 1px solid var(--line); padding: 1.1rem 1.2rem; }
  .pv__dossier::after { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0.4;
    background: repeating-linear-gradient(0deg, rgba(180,180,180,0.05) 0 1px, transparent 1px 3px); }
  .pv__d-title { font: 700 1.05rem var(--mono); letter-spacing: -0.01em; color: var(--fg);
    margin: 0 0 0.7rem; min-height: 1.3em; }
  .pv__d-desc { font: 0.82rem/1.7 var(--mono); color: var(--dim); margin: 0 0 1.1rem; min-height: 5rem; }
  .pv__dossier--contact { min-height: 0; padding-bottom: 0.9rem; }
  .pv__d-desc--short { min-height: 1.7em; margin-bottom: 0.9rem; }
  .pv__caret { display: none; width: 0.5em; height: 1.05em; background: #3ad29f;
    vertical-align: -0.16em; margin-left: 2px; }
  .typing > .pv__caret { display: inline-block; animation: pvBlink 0.8s steps(1) infinite; }
  @keyframes pvBlink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  .pv__meta { margin: 0; padding-top: 0.9rem; border-top: 1px solid var(--line); opacity: 0; }
  .pv__meta-row { display: flex; align-items: baseline; gap: 1rem; }
  .pv__k { flex: none; width: 4.5rem; font: 500 0.62rem var(--mono); letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--muted); }
  .pv__v { margin: 0; font: 0.8rem var(--mono); color: var(--fg); }

  /* links footer */
  .pv__foot { display: flex; align-items: baseline; gap: 1.4rem; margin-top: 1rem; opacity: 0; }
  .pv__links { display: flex; gap: 1.4rem; }
  .pv__link { position: relative; display: inline-flex; align-items: center; gap: 0.35rem;
    font: 0.8rem var(--mono); color: var(--muted); padding-bottom: 4px; transition: color 0.25s; }
  .pv__link .ar { font-size: 0.85em; opacity: 0.5; transition: transform 0.25s, opacity 0.25s; }
  .pv__link::after { content: ""; position: absolute; left: 0; bottom: 0; width: 100%; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 0.3s ease; }
  .pv__link:hover { color: var(--fg); }
  .pv__link:hover .ar { transform: translate(2px, -2px); opacity: 1; }
  .pv__link:hover::after { transform: scaleX(1); }
  .pv__link[hidden] { display: none; }

  @media (max-width: 720px) {
    .pv__head { justify-content: space-between; }
    .pv__idle, .pv__screen:not(.is-below) { display: none !important; }
    /* the contact dossier has to fit under the hero in one phone screen */
    .pv__dossier--contact { padding: 0.9rem 1rem 0.6rem; }
    .pv__dossier--contact .pv__d-desc--short { display: none; }
    .pv__back { display: inline-flex; gap: 0.4rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pv__link, .pv__link .ar { transition: none; }
    .typing > .pv__caret, .pv__idle .pv__caret { animation: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { createScreen } from '../scripts/screen';

  const pv = document.querySelector('.preview');
  const card = pv?.querySelector('[data-card]') as HTMLElement | null;
  const titleEl = pv?.querySelector('.pv__d-title') as HTMLElement | null;
  const descEl = pv?.querySelector('.pv__d-desc') as HTMLElement | null;
  const titleT = pv?.querySelector('[data-title-t]') as HTMLElement | null;
  const descT = pv?.querySelector('[data-desc-t]') as HTMLElement | null;
  const metaEl = pv?.querySelector('[data-meta]') as HTMLElement | null;
  const stackV = pv?.querySelector('[data-stack]') as HTMLElement | null;
  const footEl = pv?.querySelector('[data-foot]') as HTMLElement | null;
  const repo = pv?.querySelector('[data-repo]') as HTMLAnchorElement | null;
  const live = pv?.querySelector('[data-live]') as HTMLAnchorElement | null;
  const download = pv?.querySelector('[data-download]') as HTMLAnchorElement | null;
  const track = document.querySelector('[data-track]') as HTMLElement | null;
  const label = pv?.querySelector<HTMLElement>('[data-pv-label]') ?? null;
  const ctCard = pv?.querySelector<HTMLElement>('[data-contact-card]') ?? null;
  const ctTitleHost = pv?.querySelector<HTMLElement>('[data-ct-title-host]') ?? null;
  const ctTitle = pv?.querySelector<HTMLElement>('[data-ct-title]') ?? null;
  const ctDescHost = pv?.querySelector<HTMLElement>('[data-ct-desc-host]') ?? null;
  const ctDesc = pv?.querySelector<HTMLElement>('[data-ct-desc]') ?? null;
  const ctFields = Array.from(ctCard?.querySelectorAll<HTMLElement>('[data-field]') ?? []);
  const avail = document.querySelector<HTMLButtonElement>('[data-contact-open]');
  const CT_TITLE = 'write to me';
  const CT_DESC = "tell me what you're building.";
  const back = document.querySelector('[data-back]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.prj[data-proj]'));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = () => matchMedia('(max-width: 720px)').matches;

  // ---- cover screen ----
  const screenEl = pv?.querySelector<HTMLAnchorElement>('[data-screen]') ?? null;
  const screenCv = screenEl?.querySelector('canvas') ?? null;
  const screen = screenCv
    ? createScreen(screenCv, { onLuma: (l) => screenEl?.classList.toggle('is-light', l > 0.55) })
    : null;
  const GAP = 20, MIN_H = 72;

  // Fit the screen into the room between the hero and the preview column.
  function layoutScreen() {
    const off = () => { screenEl?.classList.remove('is-on', 'is-below'); return false; };
    if (!screenEl || !pv) return false;
    const page = document.querySelector('.page');
    const hero = document.querySelector('.hero');
    const lower = document.querySelector('.lower');
    const frameEl = pv.querySelector('[data-frame]');
    if (!page || !hero || !lower || !frameEl) return off();
    // mid expand/collapse the room is still moving: wait for it to settle
    if (page.classList.contains('projects-open') !== page.classList.contains('projects-reveal')) return off();

    const pvTop = pv.getBoundingClientRect().top;
    let room: number, below: boolean;
    if (page.classList.contains('projects-open')) {
      // expanded: the hero is gone; use the space the list leaves under the dossier
      below = true;
      room = lower.getBoundingClientRect().bottom - frameEl.getBoundingClientRect().bottom - GAP;
    } else {
      if (isMobile()) return off();
      below = false;
      room = pvTop - hero.getBoundingClientRect().bottom - GAP * 2;
    }
    const h = Math.min(room, pv.clientWidth * (below ? 0.625 : 0.56), below ? 320 : 230);
    if (h < MIN_H) return off();
    screenEl.style.height = `${Math.round(h)}px`;
    screenEl.style.top = below ? `${Math.round(frameEl.getBoundingClientRect().bottom - pvTop + GAP)}px` : '';
    screenEl.style.bottom = below ? 'auto' : '';
    screenEl.classList.toggle('is-below', below);
    screenEl.classList.add('is-on');
    return true;
  }
  // The picture moves exactly like the dossier card — same distances, timings
  // and back.out bounce — but vertically, strictly one after the other:
  // opening, the card lands (bounce included) and only then the picture rises
  // out of it; closing, the picture sinks back into the card and only then the
  // card leaves. With the list expanded it sits below the card: mirrored.
  const CARD_IN = 0.6;         // enterIn, bounce included
  const LEAVE = 0.18 + 0.38;   // leaveOut / screenLeave: nudge + exit
  const dir = () => (screenEl?.classList.contains('is-below') ? -1 : 1); // +1: card is under it
  let screenShown = false;

  function screenLeave(t: gsap.core.Timeline) {
    if (!screenEl) return false;
    gsap.killTweensOf(screenEl);
    if (!screenShown) return false;
    screenShown = false;
    t.to(screenEl, { y: -26 * dir(), duration: 0.18, ease: 'power2.out' }, 0);
    t.to(screenEl, { y: 170 * dir(), opacity: 0, duration: 0.38, ease: 'power3.in' }, '>');
    return true;
  }
  function screenEnter(t: gsap.core.Timeline, at: number) {
    if (!screenEl) return;
    t.add(() => { screenShown = screenEl.classList.contains('is-on'); }, at);
    t.fromTo(screenEl, { opacity: 0, y: () => 40 * dir() },
      { opacity: 1, y: 0, duration: 0.6, ease: 'back.out(2.4)', immediateRender: false }, at);
  }
  function dropScreen() {
    if (!screenEl) return;
    gsap.killTweensOf(screenEl);
    screenShown = false;
    screenEl.classList.remove('is-on', 'is-below');
    gsap.set(screenEl, { opacity: 0, y: 0 });
  }
  // measure the room, paint the cover, and park it hidden, ready to enter.
  // (No killTweensOf here: it runs mid-timeline and would kill the entrance
  // already scheduled in that same timeline. Callers outside a timeline drop
  // the screen first.)
  function stageScreen(d: DOMStringMap) {
    if (!screen || !screenEl) return false;
    screenEl.href = d.live || d.download || d.repo || '';
    screen.clear();
    if (!d.cover || !layoutScreen()) { dropScreen(); return false; }
    gsap.set(screenEl, { opacity: 0, y: 40 * dir() });
    screen.show(d.cover);
    return true;
  }
  const currentRow = () => rows.find((r) => r.dataset.proj === current);
  let resizeT = 0;
  addEventListener('resize', () => {
    clearTimeout(resizeT);
    resizeT = window.setTimeout(() => {
      const r = currentRow();
      if (!r || !screen) return;
      dropScreen();
      if (stageScreen(r.dataset)) { gsap.set(screenEl, { opacity: 1, y: 0 }); screenShown = true; }
    }, 150);
  });
  // expanding/collapsing the list moves the room: put the picture away while
  // it moves, then bring it out of the card again in the settled spot
  let relayT = 0;
  new MutationObserver(() => {
    const r = currentRow();
    if (!r) return;
    dropScreen();
    clearTimeout(relayT);
    relayT = window.setTimeout(() => {
      if (currentRow() !== r || !stageScreen(r.dataset)) return;
      const t = gsap.timeline();
      screenEnter(t, 0);
    }, 700);
  }).observe(document.querySelector('.page')!, { attributes: true, attributeFilter: ['class'] });
  // ---- zero layout shift ----
  // The panel reserves the height of its tallest possible state — the contact
  // dossier or any project's dossier — measured on invisible clones, so
  // switching between them (or from idle) can never move the page.
  const frame = pv?.querySelector<HTMLElement>('[data-frame]') ?? null;
  function reserve() {
    if (!frame || !card || !ctCard) return;
    const probe = (src: HTMLElement, fill?: (c: HTMLElement) => void) => {
      const c = src.cloneNode(true) as HTMLElement;
      c.removeAttribute('id');
      c.hidden = false;
      c.inert = true;
      c.querySelectorAll('[name]').forEach((el) => el.removeAttribute('name'));
      Object.assign(c.style, { position: 'absolute', top: '0', left: '0', right: '0',
        visibility: 'hidden', opacity: '0', transform: 'none' });
      fill?.(c);
      frame.append(c);
      const h = c.offsetHeight;
      c.remove();
      return h;
    };
    const heights = [probe(ctCard), ...rows.map((r) => probe(card, (c) => {
      const d = r.dataset;
      const set = (sel: string, v = '') => { const el = c.querySelector(sel); if (el) el.textContent = v; };
      set('[data-title-t]', d.title); set('[data-desc-t]', d.desc); set('[data-stack]', d.tags);
      c.querySelectorAll<HTMLElement>('[data-repo], [data-live], [data-download]').forEach((a) => { a.hidden = false; });
    }))];
    frame.style.minHeight = `${Math.max(...heights)}px`;
  }
  document.fonts.ready.then(reserve);
  let reserveT = 0;
  addEventListener('resize', () => { clearTimeout(reserveT); reserveT = window.setTimeout(reserve, 120); });

  // warm the cache on hover intent, so the picture is ready when the card lands
  rows.forEach((r) => r.addEventListener('pointerenter', () => screen?.preload(r.dataset.cover || ''), { once: true }));

  // Link state must NOT visibly change until the old card has left the screen.
  function applyContent(d: DOMStringMap) {
    if (repo) { if (d.repo) { repo.href = d.repo; repo.hidden = false; } else repo.hidden = true; }
    if (live) { if (d.live) { live.href = d.live; live.hidden = false; } else live.hidden = true; }
    if (download) { if (d.download) { download.href = d.download; download.hidden = false; } else download.hidden = true; }
  }

  function reset() {
    if (titleT) titleT.textContent = '';
    if (descT) descT.textContent = '';
    titleEl?.classList.remove('typing');
    descEl?.classList.remove('typing');
    if (metaEl) gsap.set(metaEl, { opacity: 0 });
    if (footEl) gsap.set(footEl, { opacity: 0 });
  }

  // `current` is a project slug, 'contact', or null; `shown` is the card on screen
  let current: string | null = null;
  let shown: HTMLElement | null = null;
  let tl: gsap.core.Timeline | null = null;

  function setMode(m: 'project' | 'contact') {
    if (card) card.hidden = m !== 'project';
    if (ctCard) ctCard.hidden = m !== 'contact';
    pv?.classList.toggle('pv-contact', m === 'contact');
    if (label) label.textContent = m === 'contact' ? '— contact' : '— preview';
    avail?.setAttribute('aria-expanded', String(m === 'contact'));
  }

  function enterIn(t: gsap.core.Timeline, el: HTMLElement) {
    t.fromTo(el, { opacity: 0, x: -40 },
      { opacity: 1, x: 0, duration: CARD_IN, ease: 'back.out(2.4)', immediateRender: false });
  }
  function leaveOut(t: gsap.core.Timeline, el: HTMLElement, after?: () => void, at?: number) {
    t.to(el, { x: 26, duration: 0.18, ease: 'power2.out' }, at);
    t.to(el, { x: -170, opacity: 0, duration: 0.38, ease: 'power3.in', onComplete: after }, '>');
  }

  function typeInto(t: gsap.core.Timeline, host: HTMLElement, span: HTMLElement, text: string, per: number) {
    const s = { i: 0 };
    t.add(() => { host.classList.add('typing'); span.textContent = ''; });
    t.to(s, { i: text.length, duration: Math.max(0.18, text.length * per),
      ease: `steps(${Math.max(1, text.length)})`,
      onUpdate() { span.textContent = text.slice(0, Math.round(s.i)); } });
  }

  function typeDossier(t: gsap.core.Timeline, d: DOMStringMap) {
    if (!titleEl || !descEl || !titleT || !descT || !metaEl || !footEl) return;
    typeInto(t, titleEl, titleT, d.title || '', 0.03);
    t.add(() => titleEl.classList.remove('typing'));
    typeInto(t, descEl, descT, d.desc || '', 0.012);   // keeps the teal caret at the end
    t.add(() => { if (stackV) stackV.textContent = d.tags || ''; });
    t.to(metaEl, { opacity: 1, duration: 0.3, ease: 'power2.out' });
    t.to(footEl, { opacity: 1, duration: 0.3, ease: 'power2.out' }, '>-0.15');
  }

  function show(slug: string, d: DOMStringMap) {
    if (!card || slug === current) return;
    const old = shown;
    current = slug;
    shown = card;
    pv?.classList.add('pv-active');
    tl?.kill();
    const prep = () => { setMode('project'); reset(); applyContent(d); };

    if (reduce || isMobile()) {
      prep();
      if (titleT) titleT.textContent = d.title || '';
      if (descT) descT.textContent = d.desc || '';
      if (stackV) stackV.textContent = d.tags || '';
      gsap.set([card, metaEl, footEl], { opacity: 1, x: 0 });
      dropScreen();
      if (stageScreen(d)) {
        if (reduce) { gsap.set(screenEl, { opacity: 1, y: 0 }); screenShown = true; }
        else screenEnter(gsap.timeline({ delay: 0.35 }), 0); // after the panel has slid in
      }
      return;
    }

    tl = gsap.timeline();
    if (old) {
      // picture back into the card, then (staggered) the card out; content
      // swaps only AFTER the old card has left (no instant flash)
      const sank = screenLeave(tl);
      leaveOut(tl, old, () => { prep(); stageScreen(d); }, sank ? LEAVE : 0);
    } else {
      prep();
      stageScreen(d);
      gsap.set(card, { opacity: 0, x: -40 });
    }
    const enterAt = tl.duration();
    enterIn(tl, card);
    typeDossier(tl, d);
    screenEnter(tl, enterAt + CARD_IN); // once the card has fully landed, out of it
  }

  function resetContact() {
    if (ctTitle) ctTitle.textContent = '';
    if (ctDesc) ctDesc.textContent = '';
    ctTitleHost?.classList.remove('typing');
    ctDescHost?.classList.remove('typing');
    gsap.set(ctFields, { opacity: 0, y: 8 });
  }
  const focusForm = () => {
    ctDescHost?.classList.remove('typing'); // the caret hands over to the input
    ctCard?.querySelector<HTMLElement>('input')?.focus({ preventScroll: true });
  };

  function showContact() {
    if (!ctCard || current === 'contact') return;
    const old = shown;
    current = 'contact';
    shown = ctCard;
    pv?.classList.add('pv-active');
    tl?.kill();
    const prep = () => { setMode('contact'); resetContact(); };

    if (reduce || isMobile()) {
      prep();
      if (ctTitle) ctTitle.textContent = CT_TITLE;
      if (ctDesc) ctDesc.textContent = CT_DESC;
      gsap.set(ctCard, { opacity: 1, x: 0 });
      gsap.set(ctFields, { opacity: 1, y: 0 });
      dropScreen();
      if (!isMobile()) focusForm();
      return;
    }

    tl = gsap.timeline();
    const sank = screenLeave(tl);
    if (old) leaveOut(tl, old, () => { prep(); dropScreen(); }, sank ? LEAVE : 0);
    else { prep(); gsap.set(ctCard, { opacity: 0, x: -40 }); }
    const enterAt = tl.duration();
    enterIn(tl, ctCard);
    if (ctTitleHost && ctTitle && ctDescHost && ctDesc) {
      typeInto(tl, ctTitleHost, ctTitle, CT_TITLE, 0.03);
      tl.add(() => ctTitleHost.classList.remove('typing'));
      typeInto(tl, ctDescHost, ctDesc, CT_DESC, 0.012);
    }
    // fields don't wait for the typing — the form is usable while it finishes
    const at = enterAt + 0.4;
    tl.to(ctFields, { opacity: 1, y: 0, stagger: 0.05, duration: 0.3, ease: 'power2.out' }, at);
    tl.add(() => ctCard.querySelector<HTMLElement>('input')?.focus({ preventScroll: true }), at);
    tl.add(() => ctDescHost?.classList.remove('typing'));
  }

  function hide() {
    if (current === null || !shown) return;
    const old = shown;
    current = null;
    shown = null;
    avail?.setAttribute('aria-expanded', 'false');
    tl?.kill();
    tl = gsap.timeline();
    // picture into the card, card away, and only then the idle prompt returns
    const sank = screenLeave(tl);
    leaveOut(tl, old, () => { dropScreen(); pv?.classList.remove('pv-active'); }, sank ? LEAVE : 0);
  }

  rows.forEach((r) => {
    const slug = r.dataset.proj!;
    r.querySelector('.prj__trigger')?.addEventListener('click', () => {
      if (isMobile()) { show(slug, r.dataset); track?.classList.add('is-preview'); return; }
      if (slug === current) hide(); else show(slug, r.dataset);
    });
  });
  back?.addEventListener('click', () => {
    track?.classList.remove('is-preview');
    if (current === 'contact') hide();
  });

  // "available for work" (hero) toggles the contact dossier, like a project row
  avail?.addEventListener('click', () => {
    if (isMobile()) { showContact(); track?.classList.add('is-preview'); return; }
    if (current === 'contact') hide(); else showContact();
  });
  // Esc closes the contact dossier from anywhere (the terminal swallows its own Esc)
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || current !== 'contact') return;
    hide();
    track?.classList.remove('is-preview');
    avail?.focus();
  });
  // the terminal's `contact`
  addEventListener('nyhz:contact', () => {
    showContact();
    if (isMobile()) track?.classList.add('is-preview');
  });
  // the terminal's `open <project>` — always shows (a row click toggles)
  addEventListener('nyhz:open', (e) => {
    const slug = (e as CustomEvent<{ slug: string }>).detail?.slug;
    const r = rows.find((row) => row.dataset.proj === slug);
    if (!slug || !r) return;
    show(slug, r.dataset);
    if (isMobile()) track?.classList.add('is-preview');
  });
</script>
