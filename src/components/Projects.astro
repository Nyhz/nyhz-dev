---
import { statusOf } from '../scripts/content';
const { projects } = Astro.props;
const HIGHLIGHT = 3;
const MAX = 10;
const shown = projects.slice(0, MAX);
const total = String(shown.length).padStart(2, '0');
const canExpand = shown.length > HIGHLIGHT;
---
<div class="projects" data-anim>
  <p class="sec-label">— selected work <span class="sec-count">[{total}]</span></p>
  <ul>
    {shown.map((p, i) => (
      <li class:list={['prj', i >= HIGHLIGHT && 'prj--extra']} data-proj={p.slug}
        data-title={p.title} data-desc={p.description} data-cover={p.coverUrl} data-repo={p.repoUrl}
        data-live={p.deployUrl} data-download={p.downloadUrl} data-tags={p.tags.join(' · ')}>
        <div class="prj__trigger" tabindex="0" role="button" aria-label={`Preview ${p.title}`}>
          <span class="prj__bar"></span>
          <span class="prj__inner">
            <span class="prj__head">
              <span class="prj__idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="prj__name">{p.title}</span>
            </span>
            <span class="prj__status" data-status={statusOf(p)}>{statusOf(p)}</span>
          </span>
        </div>
      </li>
    ))}
  </ul>
  {canExpand && (
    <div class="prj-foot">
      <button class="prj-more" data-projects-toggle type="button">
        <span data-more-label>show all</span>
        <span class="prj-more__ar" aria-hidden="true">↓</span>
      </button>
      <div class="prj-pager" data-pager hidden>
        <button type="button" class="prj-pager__btn" data-page-prev aria-label="Previous projects">←</button>
        <span class="prj-pager__n" aria-live="polite"><b data-page-now>01</b> / <span data-page-total>01</span></span>
        <button type="button" class="prj-pager__btn" data-page-next aria-label="Next projects">→</button>
      </div>
    </div>
  )}
</div>

<style>
  .projects ul { list-style: none; border-bottom: 1px solid var(--line); }
  /* no hover while the list is animating (rows sliding under the cursor) */
  .projects.is-busy ul { pointer-events: none; }
  .prj__trigger { position: relative; display: block; padding: 1rem 0; cursor: pointer;
    border-top: 1px solid var(--line); outline: none; }
  .prj__trigger:focus-visible { outline: 1px solid var(--muted); outline-offset: 4px; }
  .prj__trigger:active .prj__inner { transform: translateX(1.1rem) scale(0.985); transition-duration: var(--t-press); }

  /* shift via transform only → never reflows, no layout shift on hover */
  .prj__inner { display: block; transition: transform 0.35s cubic-bezier(.2,.7,.2,1); }
  .prj__trigger:hover .prj__inner, .prj__trigger:focus-visible .prj__inner { transform: translateX(1.1rem); }

  .prj__bar { position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--fg);
    transform: scaleY(0); transform-origin: top; transition: transform 0.35s cubic-bezier(.2,.7,.2,1); }
  .prj__trigger:hover .prj__bar, .prj__trigger:focus-visible .prj__bar { transform: scaleY(1); }

  .prj__head { display: flex; align-items: baseline; gap: 0.9rem; }
  .prj__idx { font: 0.78rem var(--mono); color: var(--muted); transition: color 0.25s; }
  .prj__trigger:hover .prj__idx { color: var(--fg); }
  .prj__name { flex: 1; font-size: clamp(1.2rem, 2.1vw, 1.5rem); font-weight: 500; letter-spacing: -0.01em; }

  .prj__status { display: block; margin-top: 0.35rem; padding-left: calc(0.78rem + 0.9rem);
    font: 0.78rem var(--mono); letter-spacing: 0.06em; color: var(--muted); }
  .prj__status[data-status="live"] { color: #3ad29f; }
  .prj__status[data-status="download"] { color: var(--dim); }

  .prj-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.2rem; }
  .prj-more { display: inline-flex; align-items: center; gap: 0.45rem;
    background: none; border: none; cursor: pointer; padding: 0;
    font: 500 0.7rem var(--mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
    transition: color 0.25s; }
  .prj-more:hover { color: var(--fg); }
  .prj-more:active { transform: translateY(1px); }
  .prj-more__ar { transition: transform 0.3s ease; }
  :global(.page.projects-open) .prj-more__ar { transform: rotate(180deg); }

  /* the expanded list never scrolls: it's paged, as many rows per page as fit */
  .prj-pager { display: none; align-items: center; gap: 0.2rem;
    font: 500 0.7rem var(--mono); letter-spacing: 0.18em; color: var(--muted); }
  .prj-pager__n b { font-weight: 500; color: var(--fg); }
  .prj-pager__btn { background: none; border: 0; padding: 0.55rem 0.7rem; cursor: pointer;
    font: inherit; color: var(--fg); transition: opacity var(--t-hover) ease; }
  .prj-pager__btn:active { transform: translateY(1px); }
  .prj-pager__btn:disabled { opacity: 0.25; cursor: default; transform: none; }
  :global(.page.projects-open.projects-reveal) .prj-pager:not([hidden]) { display: inline-flex; margin-right: -0.7rem; }
  :global(.page.projects-open.projects-reveal) .prj-foot { margin-top: auto; }
  :global(.page.projects-open) .prj.is-off { display: none; }

  /* touch devices keep a sticky :hover after a tap — kill the row hover effects
     there so a focused row's arrow doesn't bleed onto the preview */
  @media (hover: none) {
    .prj__trigger:hover .prj__inner, .prj__trigger:focus-visible .prj__inner,
    .prj__trigger:active .prj__inner { transform: none; }
    .prj__trigger:hover .prj__bar, .prj__trigger:focus-visible .prj__bar { transform: scaleY(0); }
    .prj__trigger:hover .prj__idx { color: var(--muted); }
  }
  @media (prefers-reduced-motion: reduce) {
    .prj__inner, .prj__bar, .prj__idx, .prj-more, .prj-more__ar { transition: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const page = document.querySelector('.page');
  const btn = document.querySelector('[data-projects-toggle]');
  const label = document.querySelector('[data-more-label]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DUR = 0.6;
  let animating = false;

  // ---- paging: the expanded list never scrolls. It shows as many rows as fit
  // the panel with room to spare (re-fitted on resize), the rest are pages ----
  const projectsEl = document.querySelector<HTMLElement>('.projects');
  const listEl = projectsEl?.querySelector('ul');
  const footEl = document.querySelector<HTMLElement>('.prj-foot');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.projects .prj'));
  const pager = document.querySelector<HTMLElement>('[data-pager]');
  const prevBtn = pager?.querySelector<HTMLButtonElement>('[data-page-prev]');
  const nextBtn = pager?.querySelector<HTMLButtonElement>('[data-page-next]');
  const nowEl = pager?.querySelector('[data-page-now]');
  const totalEl = pager?.querySelector('[data-page-total]');
  let per = rows.length;
  let cur = 0;
  let paging = false;
  let queued: (() => void) | null = null;
  const pages = () => Math.ceil(rows.length / per);
  const onPage = (n: number) => rows.slice(n * per, (n + 1) * per);
  const pad = (n: number) => String(n).padStart(2, '0');

  // rows that fit between the top of the list and the footer, minus half a row
  // of slack. Measured on the open layout (the lower panel already filling).
  function fit() {
    const lower = document.querySelector('.lower');
    if (!lower || !listEl || !footEl || !rows.length) return rows.length;
    const rowH = rows[0].getBoundingClientRect().height;
    const room = lower.getBoundingClientRect().bottom - listEl.getBoundingClientRect().top
      - footEl.getBoundingClientRect().height - 20;
    return Math.max(1, Math.min(rows.length, Math.floor((room - rowH * 0.5) / rowH)));
  }

  function paint() {
    const off = (i: number) => Math.floor(i / per) !== cur;
    rows.forEach((r, i) => r.classList.toggle('is-off', off(i)));
    if (pager) pager.hidden = pages() < 2;
    if (nowEl) nowEl.textContent = pad(cur + 1);
    if (totalEl) totalEl.textContent = pad(pages());
    if (prevBtn) prevBtn.disabled = cur === 0;
    if (nextBtn) nextBtn.disabled = cur >= pages() - 1;
  }

  // re-fit, keeping the first row on screen
  function refit() {
    const first = cur * per;
    per = fit();
    cur = Math.floor(first / per);
    paint();
  }
  // closed: everything back on (the collapsed list shows its first rows)
  function unpage() { per = rows.length; cur = 0; paint(); }

  // rows slide out toward the way you're going, the next page slides in after them
  function goTo(n: number, after?: () => void) {
    n = Math.max(0, Math.min(pages() - 1, n));
    // a tap mid-flip (next again, show less) runs once this flip lands
    if (paging) { queued = () => goTo(n, after); return; }
    if (n === cur) { after?.(); return; }
    const dir = n > cur ? 1 : -1;
    const out = onPage(cur);
    if (reduce) { cur = n; paint(); after?.(); return; }
    paging = true;
    projectsEl?.classList.add('is-busy');
    gsap.to(out, { x: -36 * dir, opacity: 0, duration: 0.22, ease: 'power2.in', stagger: 0.03, onComplete: () => {
      gsap.set(out, { clearProps: 'x,opacity' });
      cur = n;
      paint();
      gsap.fromTo(onPage(n), { x: 36 * dir, opacity: 0 }, { x: 0, y: 0, opacity: 1, duration: 0.42, ease: 'power3.out', stagger: 0.04,
        onComplete: () => {
          paging = false;
          if (!animating) projectsEl?.classList.remove('is-busy');
          after?.();
          const q = queued; queued = null; q?.();
        } });
    } });
  }

  const isOpen = () => !!page?.classList.contains('projects-reveal');
  prevBtn?.addEventListener('click', () => goTo(cur - 1));
  nextBtn?.addEventListener('click', () => goTo(cur + 1));

  // ← / → page on desktop (not while typing)
  addEventListener('keydown', (e) => {
    if (!isOpen() || animating || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
    if ((e.target as HTMLElement).closest('input, textarea, [contenteditable]')) return;
    goTo(cur + (e.key === 'ArrowRight' ? 1 : -1));
  });

  // swipe the list sideways to page (a clearly horizontal drag only)
  let sx = 0, sy = 0;
  listEl?.addEventListener('touchstart', (e) => {
    sx = e.touches[0].clientX; sy = e.touches[0].clientY;
  }, { passive: true });
  listEl?.addEventListener('touchend', (e) => {
    if (!isOpen() || animating) return;
    const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) goTo(cur + (dx < 0 ? 1 : -1));
  }, { passive: true });

  // a project opened from the terminal flips to its page
  addEventListener('nyhz:open', (e) => {
    const i = rows.findIndex((r) => r.dataset.proj === (e as CustomEvent<{ slug: string }>).detail?.slug);
    if (i >= 0 && isOpen()) goTo(Math.floor(i / per));
  });

  let rt = 0;
  addEventListener('resize', () => {
    clearTimeout(rt);
    rt = window.setTimeout(() => { if (isOpen() && !paging && !animating) refit(); }, 150);
  });

  // Collapse the header (height + opacity + its gap margin) and grow the list to
  // fill. Multiple growers (spacers + lower) keep the fill smooth; the header
  // fully disappears and the list rises into its place.
  let storedMb = '';
  function animateLayout(open: boolean, instant: boolean) {
    const hero = document.querySelector('.hero') as HTMLElement | null;
    const lower = document.querySelector('.lower');
    const mobile = matchMedia('(max-width: 720px)').matches;
    if (open && hero) storedMb = getComputedStyle(hero).marginBottom;
    // The spacers hand their space to the list while the hero collapses, so the
    // list rises continuously into the header's place. (Mobile used to leave the
    // spacers alone: they swallowed the collapse and the list jumped up in one
    // frame when the extra rows appeared.) Mobile's spacers are top + mid.
    const growers: [Element | null, number][] = [
      [document.querySelector('[data-spacer-top]'), open ? 0 : 1],
      [document.querySelector(mobile ? '[data-spacer-mid]' : '[data-spacer-bottom]'), open ? 0 : 1],
      [lower, open ? 1 : 0],
    ];

    if (instant) {
      if (hero) gsap.set(hero, { height: open ? 0 : 'auto', opacity: open ? 0 : 1, marginBottom: open ? 0 : (storedMb || 0) });
      growers.forEach(([el, v]) => el && gsap.set(el, { flexGrow: v }));
      return;
    }
    if (hero) {
      if (open) {
        // start from the exact measured height so there's no auto→px snap
        const h = hero.getBoundingClientRect().height;
        gsap.fromTo(hero, { height: h }, { height: 0, opacity: 0, marginBottom: 0, duration: DUR, ease: 'power2.inOut' });
      } else {
        gsap.to(hero, { height: 'auto', opacity: 1, marginBottom: storedMb || 0, duration: DUR, ease: 'power2.inOut' });
      }
    }
    growers.forEach(([el, v]) => el && gsap.to(el, { flexGrow: v, duration: DUR, ease: 'power2.inOut' }));
  }

  function setExpanded(open: boolean) {
    if (!page || animating || page.classList.contains('projects-open') === open) return;
    animating = true;
    const projects = document.querySelector('.projects');
    projects?.classList.add('is-busy');
    document.querySelector('.lower__track')?.classList.remove('is-preview');

    const apply = () => {
      page.classList.toggle('projects-open', open);
      if (label) label.textContent = open ? 'show less' : 'show all';
    };

    if (reduce) {
      if (!open) { page.classList.remove('projects-reveal'); unpage(); }
      apply();
      animateLayout(open, true);
      if (open) { cur = 0; per = fit(); paint(); page.classList.add('projects-reveal'); }
      projects?.classList.remove('is-busy');
      animating = false;
      return;
    }

    const finish = () => { projects?.classList.remove('is-busy'); animating = false; };

    // the button stays hidden through the whole transition and only fades back in
    // (opacity only, no movement) once everything has settled in its final place
    const foot = [btn, pager].filter(Boolean);
    const revealButton = () => gsap.to(foot, { opacity: 1, duration: 0.3, ease: 'power2.out', onComplete: finish });

    if (open) {
      gsap.to(foot, { opacity: 0, duration: 0.15, ease: 'power2.in', onComplete: () => {
        apply();
        animateLayout(true, false);
        gsap.delayedCall(DUR, () => {
          cur = 0;
          per = fit();
          paint();
          page.classList.add('projects-reveal');
          gsap.fromTo('.prj--extra:not(.is-off)', { opacity: 0, y: 14 },
            { opacity: 1, y: 0, duration: 0.45, stagger: 0.05, ease: 'power2.out', onComplete: revealButton });
        });
      } });
    } else {
      // from a later page, slide back to the first one before folding up
      const fold = () => gsap.to('.prj--extra:not(.is-off)', {
        opacity: 0, y: 14, duration: 0.32, ease: 'power2.in', stagger: { each: 0.05, from: 'end' },
        onComplete: () => {
          page.classList.remove('projects-reveal');
          unpage();
          apply();
          animateLayout(false, false);
          gsap.delayedCall(DUR, revealButton);
        },
      });
      gsap.to(foot, { opacity: 0, duration: 0.15, ease: 'power2.in', onComplete: () => goTo(0, fold) });
    }
  }

  btn?.addEventListener('click', () => setExpanded(!page?.classList.contains('projects-open')));

  // when expanded, a click outside the 900px column collapses (like show less)
  document.addEventListener('click', (e) => {
    if (!page?.classList.contains('projects-open')) return;
    if (!page.contains(e.target as Node)) setExpanded(false);
  });
</script>

<script>
  import { leet } from '../scripts/eggs';
  import { sound } from '../scripts/sound';
  // the l33t minute (Eggs.astro) rewrites the page's text; effects that put
  // the "real" text back must speak it too
  const say = (t: string) => (document.documentElement.classList.contains('egg-leet') ? leet(t) : t);

  // Rows are role=button divs: Enter / Space activate them like a click.
  document.querySelectorAll<HTMLElement>('.prj__trigger').forEach((t) => {
    t.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); t.click(); }
    });
  });

  // Hover / focus decodes the project name: unresolved letters cycle through
  // glyphs and lock in left→right. Mono face → widths never change.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const GLYPHS = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#%&/<>*+=';
    document.querySelectorAll<HTMLElement>('.prj__trigger').forEach((t) => {
      const name = t.querySelector<HTMLElement>('.prj__name');
      if (!name) return;
      const orig = name.textContent || '';
      let raf = 0;
      const decode = () => {
        cancelAnimationFrame(raf);
        const truth = say(orig);
        const t0 = performance.now(), dur = 90 + truth.length * 26;
        const step = (now: number) => {
          const k = Math.min((now - t0) / dur, 1);
          const locked = Math.floor(k * truth.length);
          name.textContent = truth.split('').map((c, i) =>
            i < locked || c === ' ' ? c : GLYPHS[(Math.random() * GLYPHS.length) | 0]).join('');
          if (k < 1) raf = requestAnimationFrame(step); else name.textContent = truth;
        };
        raf = requestAnimationFrame(step);
      };
      t.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { decode(); sound.tick(); } });
      // a decode during the l33t minute leaves a node the page swap doesn't know: re-set it
      addEventListener('nyhz:leet', () => setTimeout(() => { cancelAnimationFrame(raf); name.textContent = say(orig); }, 300));
      t.addEventListener('focus', decode);
    });
  }
</script>

<script>
  import { leet } from '../scripts/eggs';
  // Occasionally run one letter of a random project's status through a few
  // glyphs, then settle it back — a subtle terminal glitch on the subtitle.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const GLYPHS = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#%&/<>*+=';
  const statuses = Array.from(document.querySelectorAll<HTMLElement>('.prj__status'));
  statuses.forEach((el) => (el.dataset.value = el.textContent || ''));
  addEventListener('nyhz:leet', () => setTimeout(() => statuses.forEach((el) => {
    const v = el.dataset.value || '';
    el.textContent = document.documentElement.classList.contains('egg-leet') ? leet(v) : v;
  }), 300));

  if (!reduce && statuses.length) {
    let scrambleIv = 0;
    setInterval(() => {
      if (document.hidden || Math.random() > 0.7) return;
      const el = statuses[(Math.random() * statuses.length) | 0];
      const v = el.dataset.value || '';
      const truth = document.documentElement.classList.contains('egg-leet') ? leet(v) : v;
      if (!truth) return;
      const i = (Math.random() * truth.length) | 0;
      let n = 0;
      clearInterval(scrambleIv);
      scrambleIv = window.setInterval(() => {
        const a = truth.split('');
        a[i] = GLYPHS[(Math.random() * GLYPHS.length) | 0];
        el.textContent = a.join('');
        if (++n >= 4) { clearInterval(scrambleIv); scrambleIv = 0; el.textContent = truth; }
      }, 55);
    }, 1500);
  }
</script>
