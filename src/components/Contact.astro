---
// The contact form. It has no window of its own: the tv shows it on CH 00
// (Tv.astro owns the screen it sits on and when it's wiped).
---
<form class="cf" data-contact-form novalidate>
  <label class="cf__row" data-field>
    <span class="cf__k">name</span>
    <input name="name" type="text" maxlength="100" autocomplete="name" placeholder="your name" required />
  </label>
  <label class="cf__row" data-field>
    <span class="cf__k">email</span>
    <input name="email" type="email" maxlength="200" autocomplete="email" placeholder="where to reply" required />
  </label>
  <label class="cf__row cf__row--msg" data-field>
    <span class="cf__k">message</span>
    <textarea name="message" maxlength="5000" rows="3" placeholder="what are we building?" required></textarea>
  </label>
  <input class="hp" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="cf__foot" data-field>
    <span class="cf__status" data-contact-status role="status" aria-live="polite"></span>
    <button class="cf__send" type="submit">send <span class="ar" aria-hidden="true">↵</span></button>
  </div>
</form>

<style>
  .cf { display: flex; flex-direction: column; }
  .cf__row { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); align-items: baseline; gap: 1rem;
    padding: 0.6rem 0; border-top: 1px solid var(--line); cursor: text; }
  .cf__k { font: 500 0.62rem var(--mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
    transition: color var(--t-hover) ease; }
  .cf__row:focus-within .cf__k { color: var(--accent); }
  .cf input, .cf textarea { width: 100%; background: none; border: 0; outline: none; padding: 0; resize: none;
    font: 0.8rem/1.6 var(--mono); color: var(--fg); caret-color: var(--accent); }
  .cf ::placeholder { color: var(--muted); opacity: 0.55; }
  .cf__row:has([aria-invalid="true"]) .cf__k { color: #ff6b6b; }
  @media (max-width: 720px) {
    .cf__row { padding: 0.5rem 0; }
    .cf textarea { height: 2.6em; }
  }
  /* iOS zooms into any field under 16px on focus (and the page ends up
     panned off its frame) — touch screens get 16px, no zoom */
  @media (pointer: coarse) {
    .cf input, .cf textarea { font-size: 16px; }
  }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .cf__foot { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding-top: 0.8rem; border-top: 1px solid var(--line); }
  .cf__status { font: 0.72rem var(--mono); color: var(--muted); }
  /* transmitting: the message turns to hex, in accent, while the packet travels */
  .cf.is-tx input, .cf.is-tx textarea { color: var(--accent); }
  .cf__status[data-state="error"] { color: #ff6b6b; }
  .cf__status[data-state="ok"] { color: var(--accent); }
  .cf__send { position: relative; display: inline-flex; align-items: center; gap: 0.4rem; flex: none;
    background: none; border: 0; padding: 0 0 4px; cursor: pointer;
    font: 500 0.8rem var(--mono); color: var(--accent);
    transition: opacity 0.2s, transform var(--t-press) var(--ease-out); }
  .cf__send::after { content: ""; position: absolute; left: 0; bottom: 0; width: 100%; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 0.3s ease; }
  .cf__send:hover::after, .cf__send:focus-visible::after { transform: scaleX(1); }
  .cf__send:focus-visible { outline: none; }
  .cf__send:not(:disabled):active { transform: translateY(1px); }
  .cf__send:disabled { opacity: 0.45; cursor: default; }
  .cf__send .ar { font-size: 0.9em; }

  @media (prefers-reduced-motion: reduce) {
    .cf__send, .cf__send::after, .cf__k { transition: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { validateContact } from '../scripts/contact';
  import { sound } from '../scripts/sound';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const toHex = (t: string) => Array.from(new TextEncoder().encode(t), (b) => b.toString(16).padStart(2, '0')).join(' ');

  // Sending is a transmission: the fields encode to hex, and a packet of light
  // leaves the send button, runs to the frame's edge and along it into the
  // bottom-right corner, which lights up as it lands.
  function transmit(fields: (HTMLInputElement | HTMLTextAreaElement)[], from: DOMRect, alive: () => boolean) {
    return new Promise<void>((done) => {
      if (reduce) { done(); return; }
      fields.forEach((f) => {
        const text = f.value, hex = toHex(text);
        const o = { n: 0 };
        // left to right, characters give way to their bytes
        gsap.to(o, { n: hex.length, duration: 0.6, ease: 'none', onUpdate: () => {
          if (!alive()) return; // the form was closed (and wiped) mid-send
          const k = Math.round(o.n);
          f.value = hex.slice(0, k) + text.slice(Math.ceil(k / 3));
        } });
      });
      const border = document.querySelector('.frame__border')?.getBoundingClientRect();
      if (!border) { setTimeout(done, 600); return; }
      const x0 = from.left + from.width / 2, y0 = from.top + from.height / 2;
      const right = border.right - 1, bottom = border.bottom - 1;
      // the packet and two fainter dots trailing it
      const dots = [0, 1, 2].map((i) => {
        const d = document.createElement('i');
        d.style.cssText = `position:fixed;left:0;top:0;z-index:205;pointer-events:none;border-radius:50%;`
          + `width:${6 - i * 1.5}px;height:${6 - i * 1.5}px;margin:${-(3 - i * 0.75)}px 0 0 ${-(3 - i * 0.75)}px;`
          + `background:#3ad29f;box-shadow:0 0 ${12 - i * 4}px #3ad29f;opacity:${1 - i * 0.3}`;
        document.body.append(d);
        return d;
      });
      sound.send();
      dots.forEach((d, i) => {
        gsap.timeline({ delay: 0.25 + i * 0.05, onComplete: () => {
          d.remove();
          if (i === 0) {
            const tick = document.querySelector<HTMLElement>('.frame__border .tick.br');
            if (tick) gsap.fromTo(tick, { borderColor: '#3ad29f', boxShadow: '0 0 14px #3ad29f' },
              { borderColor: 'rgba(0,0,0,0)', boxShadow: '0 0 0 rgba(0,0,0,0)', duration: 0.9, ease: 'power2.out', clearProps: 'borderColor,boxShadow' });
            dispatchEvent(new CustomEvent('nyhz:shock', { detail: { x: right, y: bottom, strength: 1.2 } }));
            done();
          }
        } })
          .set(d, { x: x0, y: y0 })
          .to(d, { x: right, duration: 0.45, ease: 'power2.in' })
          .to(d, { y: bottom, duration: Math.max(0.15, (bottom - y0) / 1400), ease: 'none' });
      });
    });
  }

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-contact-status]');
  const sendBtn = form?.querySelector<HTMLButtonElement>('.cf__send');

  if (form && status && sendBtn) {
    const setStatus = (msg: string, state: '' | 'ok' | 'error') => {
      status.textContent = msg;
      if (state) status.setAttribute('data-state', state); else status.removeAttribute('data-state');
    };
    const flag = (name: string | null) => {
      form.querySelectorAll<HTMLInputElement>('.cf__row input, .cf__row textarea').forEach((el) => {
        if (name && el.name === name) { el.setAttribute('aria-invalid', 'true'); el.focus(); }
        else el.removeAttribute('aria-invalid');
      });
    };

    // ⌘/Ctrl + Enter sends from the message box
    form.querySelector('textarea')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); form.requestSubmit(); }
    });
    form.addEventListener('input', () => { flag(null); if (status.dataset.state === 'error') setStatus('', ''); });
    // every reset (sent, or the tv leaving CH 00) starts a new form: a reply
    // that comes back after it belongs to the old one and is dropped
    let gen = 0;
    form.addEventListener('reset', () => { gen++; });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sendBtn.disabled) return; // ⌘↵ held down: requestSubmit() ignores the disabled button
      const data = Object.fromEntries(new FormData(form).entries());
      // same rules as the API — catch the obvious ones without a round trip
      const v = validateContact(data);
      if (!v.ok) {
        setStatus(v.error, 'error');
        flag(v.error.startsWith('name') ? 'name' : v.error.includes('email') ? 'email' : 'message');
        return;
      }
      sendBtn.disabled = true;
      setStatus('transmitting…', '');
      const body = JSON.stringify(data);
      const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.cf__row input, .cf__row textarea'));
      const typed = fields.map((f) => f.value);
      form.classList.add('is-tx');
      const restore = () => { form.classList.remove('is-tx'); fields.forEach((f, i) => { f.value = typed[i]; }); };
      const g = gen;
      const alive = () => g === gen;
      const flight = transmit(fields, sendBtn.getBoundingClientRect(), alive);
      try {
        const res = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body });
        const out = await res.json().catch(() => ({}));
        await flight;
        if (!alive()) { sendBtn.disabled = false; return; }
        if (res.ok) {
          form.classList.remove('is-tx');
          form.reset();
          setStatus(`transmitted · ${(body.length / 1024).toFixed(1)}kb · ack — talk soon.`, 'ok');
        } else {
          restore(); // never lose what they wrote
          setStatus(out.error || 'something went wrong', 'error');
        }
      } catch {
        await flight;
        if (!alive()) { sendBtn.disabled = false; return; }
        restore();
        setStatus('network error — try again', 'error');
      }
      sendBtn.disabled = false;
    });
  }
</script>
