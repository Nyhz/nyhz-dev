---
// The contact form. It has no window of its own: it opens in the preview
// panel as one more dossier (Preview.astro owns the card + its entrance), and
// its rows mirror the project dossier's `stack` meta row.
---
<form class="cf" data-contact-form novalidate>
  <label class="cf__row" data-field>
    <span class="cf__k">name</span>
    <input name="name" type="text" maxlength="100" autocomplete="name" placeholder="your name" required />
  </label>
  <label class="cf__row" data-field>
    <span class="cf__k">email</span>
    <input name="email" type="email" maxlength="200" autocomplete="email" placeholder="where to reply" required />
  </label>
  <label class="cf__row cf__row--msg" data-field>
    <span class="cf__k">message</span>
    <textarea name="message" maxlength="5000" rows="3" placeholder="what are we building?" required></textarea>
  </label>
  <input class="hp" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="cf__foot" data-field>
    <span class="cf__status" data-contact-status role="status" aria-live="polite"></span>
    <button class="cf__send" type="submit">send <span class="ar" aria-hidden="true">↵</span></button>
  </div>
</form>

<style>
  .cf { display: flex; flex-direction: column; }
  .cf__row { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); align-items: baseline; gap: 1rem;
    padding: 0.6rem 0; border-top: 1px solid var(--line); cursor: text; }
  .cf__k { font: 500 0.62rem var(--mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
    transition: color var(--t-hover) ease; }
  .cf__row:focus-within .cf__k { color: var(--accent); }
  .cf input, .cf textarea { width: 100%; background: none; border: 0; outline: none; padding: 0; resize: none;
    font: 0.8rem/1.6 var(--mono); color: var(--fg); caret-color: var(--accent); }
  .cf ::placeholder { color: var(--muted); opacity: 0.55; }
  .cf__row:has([aria-invalid="true"]) .cf__k { color: #ff6b6b; }
  @media (max-width: 720px) {
    .cf__row { padding: 0.5rem 0; }
    .cf textarea { height: 3.2em; }
  }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .cf__foot { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding-top: 0.8rem; border-top: 1px solid var(--line); }
  .cf__status { font: 0.72rem var(--mono); color: var(--muted); }
  .cf__status[data-state="error"] { color: #ff6b6b; }
  .cf__status[data-state="ok"] { color: var(--accent); }
  .cf__send { position: relative; display: inline-flex; align-items: center; gap: 0.4rem; flex: none;
    background: none; border: 0; padding: 0 0 4px; cursor: pointer;
    font: 500 0.8rem var(--mono); color: var(--accent);
    transition: opacity 0.2s, transform var(--t-press) var(--ease-out); }
  .cf__send::after { content: ""; position: absolute; left: 0; bottom: 0; width: 100%; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 0.3s ease; }
  .cf__send:hover::after, .cf__send:focus-visible::after { transform: scaleX(1); }
  .cf__send:focus-visible { outline: none; }
  .cf__send:not(:disabled):active { transform: translateY(1px); }
  .cf__send:disabled { opacity: 0.45; cursor: default; }
  .cf__send .ar { font-size: 0.9em; }

  @media (prefers-reduced-motion: reduce) {
    .cf__send, .cf__send::after, .cf__k { transition: none; }
  }
</style>

<script>
  import { validateContact } from '../scripts/contact';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-contact-status]');
  const sendBtn = form?.querySelector<HTMLButtonElement>('.cf__send');

  if (form && status && sendBtn) {
    const setStatus = (msg: string, state: '' | 'ok' | 'error') => {
      status.textContent = msg;
      if (state) status.setAttribute('data-state', state); else status.removeAttribute('data-state');
    };
    const flag = (name: string | null) => {
      form.querySelectorAll<HTMLInputElement>('.cf__row input, .cf__row textarea').forEach((el) => {
        if (name && el.name === name) { el.setAttribute('aria-invalid', 'true'); el.focus(); }
        else el.removeAttribute('aria-invalid');
      });
    };

    // ⌘/Ctrl + Enter sends from the message box
    form.querySelector('textarea')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); form.requestSubmit(); }
    });
    form.addEventListener('input', () => { flag(null); if (status.dataset.state === 'error') setStatus('', ''); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      // same rules as the API — catch the obvious ones without a round trip
      const v = validateContact(data);
      if (!v.ok) {
        setStatus(v.error, 'error');
        flag(v.error.startsWith('name') ? 'name' : v.error.includes('email') ? 'email' : 'message');
        return;
      }
      sendBtn.disabled = true;
      setStatus('sending…', '');
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const out = await res.json().catch(() => ({}));
        if (res.ok) {
          setStatus('sent. talk soon.', 'ok');
          form.reset();
        } else {
          setStatus(out.error || 'something went wrong', 'error');
        }
      } catch {
        setStatus('network error — try again', 'error');
      }
      sendBtn.disabled = false;
    });
  }
</script>
